/-!
# Theorem SE (strong elliptic four exponentials at a CM slope), part (SE)

Paper addition seed 2 (`schanuel/five_exp/pilot_harvest1/PAPER_ADDITION_2_SE.md`, §1, Theorem `thm:SE` (SE)): let `E, E'`
be CM curves over `ℚ̄` with CM fields `k ≠ k'`, `Ω, Ω'` nonzero periods, `c ∈ ℚ̄ˣ`, `t = cΩ'/Ω`. If
`u₁, u₂ ∈ 𝓛̃_E = ℚ̄ + ℚ̄𝓛_E` and `Ω, u₁, u₂` are linearly independent over `ℚ̄`, then `tu₁, tu₂` are not both in
`ℚ̄ + ℚ̄𝓛_E + ℚ̄𝓛_{E'}`.

Here `E = E_L`, `E' = E_{L'}` for two `CMLattice`s (`Ω = L.ω`, `Ω' = L'.ω`); `thmSE` is conditional on W88 §5d for the
groups below (`Thm11KappaSE`), on the transcendence of `L'.ω/L.ω`, and on complex multiplication acting on elliptic
logarithms (`Bridge.CMMulLogE`). `CM4E/Bridge/SE.lean` proves the first two from `lean_lsg` when the curves are not
isogenous, and the last is proved for `ϖℤ[i]` and `Ω_ρℤ[ρ]` (`CM4E/Bridge/ELog.lean`).

## The group (the §5d hyperplane route)

The paper uses `G = G_a × E × G_a × E × E'`, `Ψ = (a₁ + z₁, a₂ + z₂ + z')`, `V = ℂ(1, t)`. The `K`-structure is made
explicit as in `CM4E/AbVar/X7.lean`: let `K ⊇ kk'` be a number field containing `c` and all coefficients, `γ` a `k`-basis
and `γ'` a `k'`-basis of `K` (`r = [K : k] = [K : k']`), and `θ = (γ_j, αγ_j)` the induced `ℚ`-basis
(`Gen.IsAdaptedFieldBasis`, `n = 2r`). The paper's `G'' = G^n / U = G_a² × A₁ × A₂ × A'` is replaced by the isogenous
group `G_a² × E^r × E^r × E'^r` in explicit coordinates `ℂ^{r + r + r}` (blocks `b1`, `b2`, `b3`), with slot forms
`μ₁ = Σ_j γ_j z_{b1 j}` and `μ₂ = Σ_j γ_j z_{b2 j} + Σ_j γ'_j z_{b3 j}`, and `Ψ'' = (μ₁ + s₁, μ₂ + s₂)` (frame
`CM4E/AbVar/FrameX1.lean`). A `K`-multiple `x·v` of a logarithm `v` of `E` is lifted to block `b` by writing `x` in the
`k`-basis: `x = Σ_j (a_j + b_j α) γ_j` gives the lift `Σ_j a_j v e_{b j} + b_j (αv) e_{b j}` (`eLiftB`), where `αv` is a
logarithm by complex multiplication. The data: one period family `θ_h(Ω, cΩ') = θ_hΩ(1, t)` and two data families
`θ_h(u_j, tu_j)`: `m = 3n`, `κ ≥ n`, `d₂ = 3r = 3n/2 < 2n`.

Soundness of the model `gmES Ls a₁ a₂` (not checked by Lean): it is the model of `G_a² × E_{Ls 0} × ⋯ × E_{Ls (m−1)}`
with `G_a²` in `d₀` (`d₀ = 2`, `d₁ = 0`, `d₂ = m`), algebraic vectors `ℚ̄^m × ℚ̄²`, logarithms generated by
`v e_j` (`v` an elliptic logarithm of an algebraic point of `E_{Ls j}`) and `G_a`-vectors with algebraic coordinates, periods
generated by `ω e_j` (`ω ∈ Λ_{Ls j}`). This is sound for every family of curves with algebraic invariants (it is the
standard model `gmStd 2 0 Ls` of `CM4E/Bridge/Std.lean` in other coordinates, `Bridge.phiFX`). Its `sub` is the uniform
subgroup condition, which is sound for `gmSE` (`aSE1`, `aSE2`): a connected algebraic subgroup of `G_a² × E^r × E^r × E'^r`
is `H₀ × B` (no homomorphisms between `G_a` and abelian varieties); a nonzero `H₀` has an algebraic vector with
`Ψ'' = (a₁, a₂) ≠ 0`; a nonzero `B` is `B₁₂ × B'` (`E`, `E'` not isogenous), `T(B₁₂)` is spanned by vectors of `k^{2r}` and
`T(B')` by vectors of `k'^r`, and `μ₁, μ₂` do not both vanish on a nonzero such vector because `γ` is `k`-independent
and `γ'` is `k'`-independent. This condition is *proved* from the subgroup data of the standard model in
`CM4E/Bridge/SE.lean` (`uniform_SE`), so for the unconditional theorem only the soundness of `gmStd` (the statement of
`lean_lsg`'s Theorem 4.1) is used.
-/

open Complex Module CM4E.Waldschmidt CM4E.Gen IntermediateField

namespace CM4E.AbVar

/-! ## `𝓛̃_E` and `ℚ̄ + ℚ̄𝓛_E + ℚ̄𝓛_{E'}` -/

/-- `𝓛̃_E = ℚ̄ + ℚ̄𝓛_E`: an algebraic constant plus algebraic multiples of elliptic logarithms of algebraic points. -/
def LtildeE (P : PeriodPair) : Set ℂ :=
  {z | ∃ (N : ℕ) (β₀ : ℂ) (β v : Fin N → ℂ), IsAlgebraic ℚ β₀ ∧ (∀ k, IsAlgebraic ℚ (β k)) ∧
    (∀ k, LogE P (v k)) ∧ z = β₀ + ∑ k, β k * v k}

/-- `ℚ̄ + ℚ̄𝓛_E + ℚ̄𝓛_{E'}`. -/
def LtildeEE (P P' : PeriodPair) : Set ℂ :=
  {z | ∃ (N N' : ℕ) (β₀ : ℂ) (β v : Fin N → ℂ) (β' v' : Fin N' → ℂ), IsAlgebraic ℚ β₀ ∧
    (∀ k, IsAlgebraic ℚ (β k)) ∧ (∀ k, LogE P (v k)) ∧ (∀ k, IsAlgebraic ℚ (β' k)) ∧ (∀ k, LogE P' (v' k)) ∧
    z = β₀ + ∑ k, β k * v k + ∑ k, β' k * v' k}

/-! ## The model of `G_a² × E₁ × ⋯ × E_m` -/

variable {m : ℕ}

/-- Algebraic vectors of `ℂ^m`. -/
def algVF (q : Fin m → ℂ) : Prop := ∀ j, IsAlgebraic ℚ (q j)

/-- `w` in coordinate `j` of `E₁ × ⋯ × E_m`. -/
noncomputable def genE (j : Fin m) (w : ℂ) : TX (Fin m → ℂ) := (Pi.single j w, 0, 0)

/-- Generators of the logarithms: `v e_j` (`v ∈ 𝓛_{E_j}`) and algebraic `G_a²`-vectors. -/
def lamES (Ls : Fin m → PeriodPair) : Set (TX (Fin m → ℂ)) :=
  {x | ∃ j w, LogE (Ls j) w ∧ x = genE j w} ∪
    {x | ∃ c₁ c₂ : ℂ, IsAlgebraic ℚ c₁ ∧ IsAlgebraic ℚ c₂ ∧ x = (0, c₁, c₂)}

/-- Generators of the periods: `ω e_j` (`ω ∈ Λ_j`). -/
def perES (Ls : Fin m → PeriodPair) : Set (TX (Fin m → ℂ)) :=
  {x | ∃ j w, w ∈ (Ls j).lattice ∧ x = genE j w}

/-- **The model of `G_a² × E₁ × ⋯ × E_m`** with slot forms `μ_i = Σ_j a_i(j) z_j`. -/
noncomputable def gmES (Ls : Fin m → PeriodPair) (a₁ a₂ : Fin m → ℂ) : GroupModel (TX (Fin m → ℂ)) :=
  gmFX1 algVF (lamES Ls) (perES Ls) (dotL a₁) (dotL a₂)

lemma PsiX_genE (a₁ a₂ : Fin m → ℂ) (j : Fin m) (w : ℂ) :
    PsiX (dotL a₁) (dotL a₂) (genE j w) = (a₁ j * w, a₂ j * w) := by
  simp [PsiX_apply, genE, dotL_single]

lemma PsiX_ga (a₁ a₂ : Fin m → ℂ) (s₁ s₂ : ℂ) :
    PsiX (dotL a₁) (dotL a₂) (((0 : Fin m → ℂ), s₁, s₂) : TX (Fin m → ℂ)) = (s₁, s₂) := by
  simp [PsiX_apply]

/-! ## The blocks -/

variable {r : ℕ}

/-- Block 1 (`E`, read by `μ₁`). -/
def b1 (i : Fin r) : Fin (r + r + r) := Fin.castAdd r (Fin.castAdd r i)
/-- Block 2 (`E`, read by `μ₂`). -/
def b2 (i : Fin r) : Fin (r + r + r) := Fin.castAdd r (Fin.natAdd r i)
/-- Block 3 (`E'`, read by `μ₂`). -/
def b3 (i : Fin r) : Fin (r + r + r) := Fin.natAdd (r + r) i

lemma sum_blocks {M : Type*} [AddCommMonoid M] (f : Fin (r + r + r) → M) :
    ∑ j, f j = ∑ i, f (b1 i) + ∑ i, f (b2 i) + ∑ i, f (b3 i) := by
  rw [Fin.sum_univ_add, Fin.sum_univ_add]
  rfl

lemma forall_blocks {P : Fin (r + r + r) → Prop} (h1 : ∀ i, P (b1 i)) (h2 : ∀ i, P (b2 i)) (h3 : ∀ i, P (b3 i))
    (j : Fin (r + r + r)) : P j := by
  refine Fin.addCases (fun k => ?_) (fun i => h3 i) j
  exact Fin.addCases (fun i => h1 i) (fun i => h2 i) k

/-- The curves: `E` on blocks 1, 2 and `E'` on block 3. -/
def lsSE (P P' : PeriodPair) (r : ℕ) : Fin (r + r + r) → PeriodPair :=
  Fin.append (Fin.append (fun _ : Fin r => P) (fun _ : Fin r => P)) (fun _ : Fin r => P')

/-- The coefficients of `μ₁`: `γ` on block 1. -/
def aSE1 (γ : Fin r → ℂ) : Fin (r + r + r) → ℂ := Fin.append (Fin.append γ 0) 0

/-- The coefficients of `μ₂`: `γ` on block 2, `γ'` on block 3. -/
def aSE2 (γ γ' : Fin r → ℂ) : Fin (r + r + r) → ℂ := Fin.append (Fin.append 0 γ) γ'

@[simp] lemma lsSE_b1 (P P' : PeriodPair) (i : Fin r) : lsSE P P' r (b1 i) = P := by simp only [lsSE, b1, Fin.append_left]
@[simp] lemma lsSE_b2 (P P' : PeriodPair) (i : Fin r) : lsSE P P' r (b2 i) = P := by simp only [lsSE, b2, Fin.append_left, Fin.append_right]
@[simp] lemma lsSE_b3 (P P' : PeriodPair) (i : Fin r) : lsSE P P' r (b3 i) = P' := by simp only [lsSE, b3, Fin.append_right]
@[simp] lemma aSE1_b1 (γ : Fin r → ℂ) (i : Fin r) : aSE1 γ (b1 i) = γ i := by simp only [aSE1, b1, Fin.append_left]
@[simp] lemma aSE1_b2 (γ : Fin r → ℂ) (i : Fin r) : aSE1 γ (b2 i) = 0 := by simp only [aSE1, b2, Fin.append_left, Fin.append_right, Pi.zero_apply]
@[simp] lemma aSE1_b3 (γ : Fin r → ℂ) (i : Fin r) : aSE1 γ (b3 i) = 0 := by simp only [aSE1, b3, Fin.append_right, Pi.zero_apply]
@[simp] lemma aSE2_b1 (γ γ' : Fin r → ℂ) (i : Fin r) : aSE2 γ γ' (b1 i) = 0 := by simp only [aSE2, b1, Fin.append_left, Pi.zero_apply]
@[simp] lemma aSE2_b2 (γ γ' : Fin r → ℂ) (i : Fin r) : aSE2 γ γ' (b2 i) = γ i := by simp only [aSE2, b2, Fin.append_left, Fin.append_right]
@[simp] lemma aSE2_b3 (γ γ' : Fin r → ℂ) (i : Fin r) : aSE2 γ γ' (b3 i) = γ' i := by simp only [aSE2, b3, Fin.append_right]

lemma lsSE_cases (P P' : PeriodPair) (j : Fin (r + r + r)) : lsSE P P' r j = P ∨ lsSE P P' r j = P' :=
  forall_blocks (P := fun j => lsSE P P' r j = P ∨ lsSE P P' r j = P') (fun i => by simp) (fun i => by simp)
    (fun i => by simp) j

/-- **The model of Theorem SE**: `G_a² × E^r × E^r × E'^r`. -/
noncomputable def gmSE (L L' : CMLattice) (γ γ' : Fin r → ℂ) : GroupModel (TX (Fin (r + r + r) → ℂ)) :=
  gmES (lsSE L.pp L'.pp r) (aSE1 γ) (aSE2 γ γ')

/-- **The hypothesis for Theorem SE**: W88 §5d for `G_a² × E^r × E^r × E'^r` (`E = E_L`, `E' = E_{L'}`), for every pair of
adapted bases, when both curves have algebraic invariants and are not isogenous (for isogenous curves the model is unsound:
an antidiagonal abelian subvariety of `E^r × E'^r` lies in `ker Ψ''`; `reviews/REFEREE_HYP_SE.md`). Proved in
`CM4E/Bridge/SE.lean` (`Bridge.thm11KappaSE_of_nonIsog`). -/
def Thm11KappaSE (L L' : CMLattice) : Prop :=
  LSG.W88.NonIsog L.pp L'.pp → LSG.W88.NonIsog L'.pp L.pp →
    IsAlgebraic ℚ L.pp.g₂ → IsAlgebraic ℚ L.pp.g₃ → IsAlgebraic ℚ L'.pp.g₂ → IsAlgebraic ℚ L'.pp.g₃ →
    ∀ (r : ℕ) (γ γ' : Fin r → ℂ), IsAdaptedFieldBasis L.α γ → IsAdaptedFieldBasis L'.α γ' →
      HyperplaneKappa (gmSE L L' γ γ')

/-! ## Lifts of `K`-multiples of logarithms -/

/-- `x·v` in block `blk`, with `x` written in the `k`-basis `γ` (`k = ℚ(α)`): `Σ_j (a_j v + b_j αv) e_{blk j}`. -/
noncomputable def eLiftB (α : ℂ) (γ : Fin r → ℂ) (blk : Fin r → Fin m) (x v : ℂ) : TX (Fin m → ℂ) :=
  ∑ i, ((coordsA α γ x (i, 0)) • genE (blk i) v + (coordsA α γ x (i, 1)) • genE (blk i) (α * v))

lemma PsiX_qsmulF (a₁ a₂ : Fin m → ℂ) (q : ℚ) (v : TX (Fin m → ℂ)) :
    PsiX (dotL a₁) (dotL a₂) (q • v) =
      ((q : ℂ) * (PsiX (dotL a₁) (dotL a₂) v).1, (q : ℂ) * (PsiX (dotL a₁) (dotL a₂) v).2) := by
  rw [map_rat_smul]
  exact Prod.ext (by rw [Prod.smul_fst, Rat.smul_def]) (by rw [Prod.smul_snd, Rat.smul_def])

lemma PsiX_eLiftB (a₁ a₂ : Fin m → ℂ) (α : ℂ) (γ : Fin r → ℂ) (blk : Fin r → Fin m) (x v : ℂ) :
    PsiX (dotL a₁) (dotL a₂) (eLiftB α γ blk x v) =
      (∑ i, a₁ (blk i) * ((coordsA α γ x (i, 0) : ℂ) * v + (coordsA α γ x (i, 1) : ℂ) * (α * v)),
        ∑ i, a₂ (blk i) * ((coordsA α γ x (i, 0) : ℂ) * v + (coordsA α γ x (i, 1) : ℂ) * (α * v))) := by
  simp only [eLiftB, map_sum, map_add, PsiX_qsmulF, PsiX_genE]
  refine Prod.ext ?_ ?_
  · simp only [Prod.fst_sum, Prod.fst_add]
    exact Finset.sum_congr rfl fun i _ => by ring
  · simp only [Prod.snd_sum, Prod.snd_add]
    exact Finset.sum_congr rfl fun i _ => by ring

lemma sum_coords {α : ℂ} {γ : Fin r → ℂ} {x : ℂ} (hx : x ∈ Kspan α γ) (v : ℂ) :
    ∑ i, γ i * ((coordsA α γ x (i, 0) : ℂ) * v + (coordsA α γ x (i, 1) : ℂ) * (α * v)) = x * v := by
  have e := coordsA_spec hx
  rw [Fintype.sum_prod_type] at e
  simp only [Fin.sum_univ_two] at e
  have t0 : ∀ i, theta α γ (i, 0) = γ i := fun i => by simp [theta]
  have t1 : ∀ i, theta α γ (i, 1) = α * γ i := fun i => by simp [theta]
  simp only [t0, t1] at e
  calc _ = (∑ i, ((coordsA α γ x (i, 0) : ℂ) * γ i + (coordsA α γ x (i, 1) : ℂ) * (α * γ i))) * v := by
        rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun i _ => by ring
    _ = x * v := by rw [e]

lemma eLiftB_mem_lam (Ls : Fin m → PeriodPair) (α : ℂ) (γ : Fin r → ℂ) (blk : Fin r → Fin m) (x v : ℂ)
    (hv : ∀ i, LogE (Ls (blk i)) v) (hαv : ∀ i, LogE (Ls (blk i)) (α * v)) :
    eLiftB α γ blk x v ∈ Submodule.span ℚ (lamES Ls) :=
  Submodule.sum_mem _ fun i _ => add_mem
    (Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨blk i, v, hv i, rfl⟩)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨blk i, α * v, hαv i, rfl⟩)))

lemma eLiftB_mem_per (Ls : Fin m → PeriodPair) (α : ℂ) (γ : Fin r → ℂ) (blk : Fin r → Fin m) (x v : ℂ)
    (hv : ∀ i, v ∈ (Ls (blk i)).lattice) (hαv : ∀ i, α * v ∈ (Ls (blk i)).lattice) :
    eLiftB α γ blk x v ∈ Submodule.span ℚ (perES Ls) :=
  Submodule.sum_mem _ fun i _ => add_mem
    (Submodule.smul_mem _ _ (Submodule.subset_span ⟨blk i, v, hv i, rfl⟩))
    (Submodule.smul_mem _ _ (Submodule.subset_span ⟨blk i, α * v, hαv i, rfl⟩))

lemma PsiX_lift1 {α : ℂ} {γ γ'' γ' : Fin r → ℂ} {x : ℂ} (hx : x ∈ Kspan α γ) (v : ℂ) :
    PsiX (dotL (aSE1 γ)) (dotL (aSE2 γ'' γ')) (eLiftB α γ b1 x v) = (x * v, 0) := by
  rw [PsiX_eLiftB]; simp only [aSE1_b1, aSE2_b1, zero_mul, Finset.sum_const_zero, sum_coords hx]

lemma PsiX_lift2 {α : ℂ} {γ'' γ γ' : Fin r → ℂ} {x : ℂ} (hx : x ∈ Kspan α γ) (v : ℂ) :
    PsiX (dotL (aSE1 γ'')) (dotL (aSE2 γ γ')) (eLiftB α γ b2 x v) = (0, x * v) := by
  rw [PsiX_eLiftB]; simp only [aSE1_b2, aSE2_b2, zero_mul, Finset.sum_const_zero, sum_coords hx]

lemma PsiX_lift3 {α : ℂ} {γ'' γ γ' : Fin r → ℂ} {x : ℂ} (hx : x ∈ Kspan α γ') (v : ℂ) :
    PsiX (dotL (aSE1 γ'')) (dotL (aSE2 γ γ')) (eLiftB α γ' b3 x v) = (0, x * v) := by
  rw [PsiX_eLiftB]; simp only [aSE1_b3, aSE2_b3, zero_mul, Finset.sum_const_zero, sum_coords hx]

/-! ## A number field with a `k`-basis and a `k'`-basis -/

/-- An adapted basis of `ℚ(α, T)` (`T` finite, algebraic). -/
theorem exists_adapted_basis_adjoin (α : ℂ) (hα : IsAlgebraic ℚ α) (him : α.im ≠ 0)
    (hquad : ∃ p q : ℚ, α ^ 2 = p + q * α) (T : Set ℂ) (hTf : T.Finite) (hT : ∀ s ∈ T, IsAlgebraic ℚ s) :
    ∃ r : ℕ, ∃ b : Fin r → ℂ, IsAdaptedFieldBasis α b ∧
      ∀ x, x ∈ Kspan α b ↔ x ∈ IntermediateField.adjoin ℚ (insert α T) := by
  obtain ⟨p, q, hpq⟩ := hquad
  have hαi : IsIntegral ℚ α := hα.isIntegral
  have hdeg := natDegree_minpoly_eq_two hαi him hpq
  set pb := IntermediateField.adjoin.powerBasis hαi
  have hdim : pb.dim = 2 := by rw [IntermediateField.adjoin.powerBasis_dim]; exact hdeg
  set bk : Module.Basis (Fin 2) ℚ ℚ⟮α⟯ := pb.basis.reindex (finCongr hdim)
  have h0 : ((bk 0 : ℚ⟮α⟯) : ℂ) = 1 := by
    simp [bk, Module.Basis.reindex_apply, PowerBasis.coe_basis]
  have h1 : ((bk 1 : ℚ⟮α⟯) : ℂ) = α := by
    simp [bk, Module.Basis.reindex_apply, PowerBasis.coe_basis, pb, IntermediateField.adjoin.powerBasis_gen]
  have : FiniteDimensional ℚ ℚ⟮α⟯ := IntermediateField.adjoin.finiteDimensional hαi
  set K : IntermediateField ℚ⟮α⟯ ℂ := IntermediateField.adjoin ℚ⟮α⟯ T
  have hTi : ∀ x ∈ T, IsIntegral ℚ⟮α⟯ x := fun x hx => (hT x hx).isIntegral.tower_top
  have : Finite T := hTf.to_subtype
  have : FiniteDimensional ℚ⟮α⟯ K := IntermediateField.finiteDimensional_adjoin hTi
  have : Module.Free ℚ⟮α⟯ K := Module.Free.of_divisionRing _ _
  set r := Module.finrank ℚ⟮α⟯ K
  set b' := Module.finBasis ℚ⟮α⟯ K
  set B : Module.Basis (Fin r × Fin 2) ℚ K := bk.smulTower' b'
  let f : K →ₗ[ℚ] ℂ := (K.val.restrictScalars ℚ).toLinearMap
  have hf : Function.Injective f := Subtype.val_injective
  set b : Fin r → ℂ := fun j => (b' j : ℂ)
  have htheta : theta α b = f ∘ B := by
    funext ⟨j, i⟩
    fin_cases i
    · simp [theta, B, Module.Basis.smulTower'_apply, f, b, Algebra.smul_def, h0]
    · simp [theta, B, Module.Basis.smulTower'_apply, f, b, Algebra.smul_def, h1]
  have hspan : ∀ x, x ∈ Kspan α b ↔ x ∈ K := by
    intro x
    rw [Kspan, htheta, Set.range_comp, Submodule.span_image, B.span_eq, Submodule.map_top,
      LinearMap.mem_range]
    constructor
    · rintro ⟨y, rfl⟩
      exact y.2
    · intro hx
      exact ⟨⟨x, hx⟩, rfl⟩
  have hKQ : ∀ x, x ∈ K ↔ x ∈ IntermediateField.adjoin ℚ (insert α T) := by
    intro x
    have e := IntermediateField.adjoin_adjoin_left ℚ ({α} : Set ℂ) T
    rw [Set.singleton_union] at e
    rw [← e, IntermediateField.mem_restrictScalars]
  have halg : ∀ x ∈ K, IsAlgebraic ℚ x := by
    intro x hx
    have : Module.Finite ℚ K := Module.Finite.trans ℚ⟮α⟯ K
    have : IsIntegral ℚ (⟨x, hx⟩ : K) := IsIntegral.of_finite ℚ _
    exact (this.map (K.val.restrictScalars ℚ)).isAlgebraic
  refine ⟨r, b, ⟨?_, ?_, ?_, ?_, ?_⟩, fun x => (hspan x).trans (hKQ x)⟩
  · rw [htheta]
    exact B.linearIndependent.map' f (LinearMap.ker_eq_bot.mpr hf)
  · rw [hspan]
    exact K.one_mem
  · intro x hx y hy
    rw [hspan] at *
    exact K.mul_mem hx hy
  · intro x hx
    rw [hspan] at *
    exact K.inv_mem hx
  · intro j
    exact halg _ (b' j).2

/-- **Adapted bases over `k = ℚ(α)` and over `k' = ℚ(α')` of the same number field** `K ⊇ S ∪ {α, α'}`, `[K : k] = r`. -/
theorem exists_adapted_basis_pair (α α' : ℂ) (hα : IsAlgebraic ℚ α) (him : α.im ≠ 0)
    (hquad : ∃ p q : ℚ, α ^ 2 = p + q * α) (hα' : IsAlgebraic ℚ α') (him' : α'.im ≠ 0)
    (hquad' : ∃ p q : ℚ, α' ^ 2 = p + q * α') (S : Finset ℂ) (hS : ∀ s ∈ S, IsAlgebraic ℚ s) :
    ∃ r : ℕ, 1 ≤ r ∧ ∃ γ γ' : Fin r → ℂ, IsAdaptedFieldBasis α γ ∧ IsAdaptedFieldBasis α' γ' ∧
      (∀ x, x ∈ Kspan α γ → x ∈ Kspan α' γ') ∧ (∀ s ∈ S, s ∈ Kspan α γ) ∧ α' ∈ Kspan α γ := by
  obtain ⟨r, γ, hb, hK⟩ := exists_adapted_basis_adjoin α hα him hquad (insert α' (S : Set ℂ))
    ((S.finite_toSet).insert α') (by
      rintro s (rfl | hs)
      exacts [hα', hS s hs])
  obtain ⟨r', γ', hb', hK'⟩ := exists_adapted_basis_adjoin α' hα' him' hquad' (insert α (S : Set ℂ))
    ((S.finite_toSet).insert α) (by
      rintro s (rfl | hs)
      exacts [hα, hS s hs])
  have hset : insert α (insert α' (S : Set ℂ)) = insert α' (insert α (S : Set ℂ)) := Set.insert_comm _ _ _
  have hiff : ∀ x, x ∈ Kspan α γ ↔ x ∈ Kspan α' γ' := fun x => by rw [hK, hK', hset]
  have hKeq : Kspan α γ = Kspan α' γ' := by ext x; exact hiff x
  have hr : r' = r := by
    have e1 := finrank_span_eq_card hb.indep
    have e2 := finrank_span_eq_card hb'.indep
    have : Module.finrank ℚ (Kspan α γ) = Module.finrank ℚ (Kspan α' γ') := by rw [hKeq]
    rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin] at e1 e2
    have e1' : Module.finrank ℚ (Kspan α γ) = r * 2 := e1
    have e2' : Module.finrank ℚ (Kspan α' γ') = r' * 2 := e2
    omega
  subst hr
  have hr1 : 1 ≤ r' := by
    by_contra h
    have h0 : r' = 0 := by omega
    subst h0
    have h1 := hb.one_mem
    rw [Kspan, Set.range_eq_empty, Submodule.span_empty, Submodule.mem_bot] at h1
    exact one_ne_zero h1
  refine ⟨r', hr1, γ, γ', hb, hb', fun x hx => (hiff x).mp hx, fun s hs => ?_, ?_⟩
  · rw [hK]; exact IntermediateField.subset_adjoin _ _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ hs))
  · rw [hK]; exact IntermediateField.subset_adjoin _ _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

lemma Kspan_isAlgebraic {α : ℂ} (hα : IsAlgebraic ℚ α) {γ : Fin r → ℂ} (hγ : ∀ j, IsAlgebraic ℚ (γ j)) {x : ℂ}
    (hx : x ∈ Kspan α γ) : IsAlgebraic ℚ x := by
  obtain ⟨c, rfl⟩ := exists_coords hx
  rw [← mem_algebraicClosure_iff]
  exact sum_mem fun j _ => mul_mem (mem_algebraicClosure_iff.mpr (isAlgebraic_algebraMap (c j)))
    (mem_algebraicClosure_iff.mpr (theta_isAlgebraic hα hγ j))

/-! ## Theorem SE -/

/-- **Theorem SE, part (SE)** (paper addition seed 2, Theorem `thm:SE` (1)), for two CM lattices `L, L'`:
for `c ∈ ℚ̄ˣ`, `t = c·L'.ω/L.ω` and `u₁, u₂ ∈ 𝓛̃_{E_L}` with `L.ω, u₁, u₂` linearly independent over `ℚ̄`, the numbers
`tu₁, tu₂` are not both in `ℚ̄ + ℚ̄𝓛_{E_L} + ℚ̄𝓛_{E_{L'}}`. Hypotheses: W88 §5d for `G_a² × E^r × E^r × E'^r` (`hW`),
non-isogeny (`hni`, `hni'`), algebraic invariants, complex multiplication on elliptic logarithms (`hCM`, `hCM'`), and
`L'.ω/L.ω ∉ ℚ̄` (`hT`). -/
theorem thmSE (L L' : CMLattice) (hW : Thm11KappaSE L L') (hni : LSG.W88.NonIsog L.pp L'.pp)
    (hni' : LSG.W88.NonIsog L'.pp L.pp) (hg₂ : IsAlgebraic ℚ L.pp.g₂)
    (hg₃ : IsAlgebraic ℚ L.pp.g₃) (hg₂' : IsAlgebraic ℚ L'.pp.g₂) (hg₃' : IsAlgebraic ℚ L'.pp.g₃)
    (hCM : Bridge.CMMulLogE L) (hCM' : Bridge.CMMulLogE L') (hT : Transcendental ℚ (L'.ω / L.ω))
    (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) (u : Fin 2 → ℂ) (hu : ∀ j, u j ∈ LtildeE L.pp)
    (hind : ∀ a₀ a₁ a₂ : ℂ, IsAlgebraic ℚ a₀ → IsAlgebraic ℚ a₁ → IsAlgebraic ℚ a₂ →
      a₀ * L.ω + a₁ * u 0 + a₂ * u 1 = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) :
    ¬ ∀ j, c * L'.ω / L.ω * u j ∈ LtildeEE L.pp L'.pp := by
  intro hall
  have hω := L.ω_ne_zero
  choose N β₀ β v hβ₀ hβ hv hu' using hu
  choose N₁ N₂ δ₀ δ w δ' w' hδ₀ hδ hw hδ' hw' heq using hall
  -- the field
  obtain ⟨r, hr1, γ, γ', hb, hb', hKK', hS, -⟩ := exists_adapted_basis_pair L.α L'.α L.isAlgebraic_α L.him.ne'
    ⟨L.p, L.q, L.hquad⟩ L'.isAlgebraic_α L'.him.ne' ⟨L'.p, L'.q, L'.hquad⟩
    (insert c (Finset.univ.biUnion fun j : Fin 2 =>
      Finset.univ.image (β j) ∪ Finset.univ.image (δ j) ∪ Finset.univ.image (δ' j))) (by
      intro s hs
      simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ,
        true_and] at hs
      rcases hs with rfl | ⟨j, (⟨k, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩⟩
      exacts [hc, hβ j k, hδ j k, hδ' j k])
  have hcK : c ∈ Kspan L.α γ := hS c (by simp)
  have hβK : ∀ j k, β j k ∈ Kspan L.α γ := fun j k => hS _ (by
    simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
    exact Or.inr ⟨j, Or.inl (Or.inl ⟨k, rfl⟩)⟩)
  have hδK : ∀ j k, δ j k ∈ Kspan L.α γ := fun j k => hS _ (by
    simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
    exact Or.inr ⟨j, Or.inl (Or.inr ⟨k, rfl⟩)⟩)
  have hδ'K : ∀ j k, δ' j k ∈ Kspan L.α γ := fun j k => hS _ (by
    simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
    exact Or.inr ⟨j, Or.inr ⟨k, rfl⟩⟩)
  set θ := theta L.α γ with hθ
  have hθalg := theta_isAlgebraic L.isAlgebraic_α hb.alg
  have hθK : ∀ h, θ h ∈ Kspan L.α γ := fun h => Submodule.subset_span ⟨h, rfl⟩
  have hmK : ∀ h {x}, x ∈ Kspan L.α γ → θ h * x ∈ Kspan L.α γ := fun h x hx => hb.mul_mem _ (hθK h) _ hx
  set Ls := lsSE L.pp L'.pp r
  set a₁ := aSE1 γ
  set a₂ := aSE2 γ γ'
  -- `σ = t` is transcendental
  set σ := c * L'.ω / L.ω with hσdef
  have hσ : Transcendental ℚ σ := by
    intro halg
    apply hT
    have : L'.ω / L.ω = σ / c := by rw [hσdef]; field_simp
    rw [this, ← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr halg) (mem_algebraicClosure_iff.mpr hc)
  -- lattice facts
  have hωL : L.ω ∈ L.pp.lattice := L.hω₁ ▸ L.pp.ω₁_mem_lattice
  have hαωL : L.α * L.ω ∈ L.pp.lattice := L.hω₂ ▸ L.pp.ω₂_mem_lattice
  have hωL' : L'.ω ∈ L'.pp.lattice := L'.hω₁ ▸ L'.pp.ω₁_mem_lattice
  have hαωL' : L'.α * L'.ω ∈ L'.pp.lattice := L'.hω₂ ▸ L'.pp.ω₂_mem_lattice
  -- the period lifts
  let p : Fin r × Fin 2 → TX (Fin (r + r + r) → ℂ) := fun h =>
    eLiftB L.α γ b1 (θ h) L.ω + eLiftB L'.α γ' b3 (θ h * c) L'.ω
  have hpl : ∀ h, p h ∈ Submodule.span ℚ (lamES Ls) := fun h =>
    add_mem (eLiftB_mem_lam Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b1]; exact Or.inl hωL)
        (fun i => by simp only [Ls, lsSE_b1]; exact Or.inl hαωL))
      (eLiftB_mem_lam Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b3]; exact Or.inl hωL')
        (fun i => by simp only [Ls, lsSE_b3]; exact Or.inl hαωL'))
  have hpp : ∀ h, p h ∈ Submodule.span ℚ (perES Ls) := fun h =>
    add_mem (eLiftB_mem_per Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b1]; exact hωL)
        (fun i => by simp only [Ls, lsSE_b1]; exact hαωL))
      (eLiftB_mem_per Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b3]; exact hωL')
        (fun i => by simp only [Ls, lsSE_b3]; exact hαωL'))
  have hpΨ : ∀ h, PsiX (dotL a₁) (dotL a₂) (p h) = (θ h * L.ω, σ * (θ h * L.ω)) := by
    intro h
    simp only [p, map_add, a₁, a₂, PsiX_lift1 (hθK h), PsiX_lift3 (hKK' _ (hmK h hcK))]
    refine Prod.ext (by simp) ?_
    simp only [Prod.snd_add, zero_add, hσdef]
    field_simp
  -- the data lifts
  let d : Fin 2 → Fin r × Fin 2 → TX (Fin (r + r + r) → ℂ) := fun j h =>
    ∑ k, eLiftB L.α γ b1 (θ h * β j k) (v j k) + (((0 : Fin (r + r + r) → ℂ), θ h * β₀ j, θ h * δ₀ j) : _) +
      ∑ k, eLiftB L.α γ b2 (θ h * δ j k) (w j k) + ∑ k, eLiftB L'.α γ' b3 (θ h * δ' j k) (w' j k)
  have hdl : ∀ j h, d j h ∈ Submodule.span ℚ (lamES Ls) := by
    intro j h
    refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
    · exact Submodule.sum_mem _ fun k _ => eLiftB_mem_lam Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b1]; exact hv j k)
        (fun i => by simp only [Ls, lsSE_b1]; exact hCM _ (hv j k))
    · exact Submodule.subset_span (Or.inr ⟨_, _, (hθalg h).mul (hβ₀ j), (hθalg h).mul (hδ₀ j), rfl⟩)
    · exact Submodule.sum_mem _ fun k _ => eLiftB_mem_lam Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b2]; exact hw j k)
        (fun i => by simp only [Ls, lsSE_b2]; exact hCM _ (hw j k))
    · exact Submodule.sum_mem _ fun k _ => eLiftB_mem_lam Ls _ _ _ _ _ (fun i => by simp only [Ls, lsSE_b3]; exact hw' j k)
        (fun i => by simp only [Ls, lsSE_b3]; exact hCM' _ (hw' j k))
  have hdΨ : ∀ j h, PsiX (dotL a₁) (dotL a₂) (d j h) = (θ h * u j, σ * (θ h * u j)) := by
    intro j h
    simp only [d, map_add, map_sum, a₁, a₂, PsiX_lift1 (hmK h (hβK j _)), PsiX_lift2 (hmK h (hδK j _)),
      PsiX_lift3 (hKK' _ (hmK h (hδ'K j _))), PsiX_ga]
    refine Prod.ext ?_ ?_
    · simp only [Prod.fst_add, Prod.fst_sum, Finset.sum_const_zero, add_zero]
      rw [hu' j, mul_add, Finset.mul_sum, add_comm]
      congr 1
      exact Finset.sum_congr rfl fun k _ => by ring
    · simp only [Prod.snd_add, Prod.snd_sum, Finset.sum_const_zero, zero_add]
      rw [show σ * (θ h * u j) = θ h * (σ * u j) by ring, hσdef, heq j, mul_add, mul_add, Finset.mul_sum,
        Finset.mul_sum]
      congr 1
      · congr 1
        exact Finset.sum_congr rfl fun k _ => by ring
      · exact Finset.sum_congr rfl fun k _ => by ring
  -- algebraicity of the slot forms
  have ha₁ : ∀ j, IsAlgebraic ℚ (a₁ j) :=
    forall_blocks (P := fun j => IsAlgebraic ℚ (a₁ j)) (fun i => by simpa [a₁] using hb.alg i)
      (fun i => by simp [a₁, isAlgebraic_zero]) (fun i => by simp [a₁, isAlgebraic_zero])
  have ha₂ : ∀ j, IsAlgebraic ℚ (a₂ j) :=
    forall_blocks (P := fun j => IsAlgebraic ℚ (a₂ j)) (fun i => by simp [a₂, isAlgebraic_zero])
      (fun i => by simpa [a₂] using hb.alg i) (fun i => by simpa [a₂] using hb'.alg i)
  have hμ : ∀ a : Fin (r + r + r) → ℂ, (∀ j, IsAlgebraic ℚ (a j)) →
      ∀ q, algVF q → IsAlgebraic ℚ (dotL a q) := by
    intro a ha q hq
    rw [dotL_apply, ← mem_algebraicClosure_iff]
    exact sum_mem fun j _ => mul_mem (mem_algebraicClosure_iff.mpr (ha j)) (mem_algebraicClosure_iff.mpr (hq j))
  refine frameX1_false (dotL a₁) (dotL a₂) θ hb.indep algVF (lamES Ls) (perES Ls)
    (hW hni hni' hg₂ hg₃ hg₂' hg₃' r γ γ' hb hb') (by simp; omega) (hμ a₁ ha₁) (hμ a₂ ha₂)
    (Set.range fun j => (Pi.single j (1 : ℂ) : Fin (r + r + r) → ℂ)) ?_ ?_ σ hσ L.ω (u 0) (u 1) ?_
    p hpl hpp hpΨ (d 0) (d 1) (hdl 0) (hdl 1) (hdΨ 0) (hdΨ 1)
  · rintro _ ⟨j, rfl⟩ k
    simp only [Pi.single_apply]
    split_ifs
    exacts [isAlgebraic_one, isAlgebraic_zero]
  · rw [show (Set.range fun j => (Pi.single j (1 : ℂ) : Fin (r + r + r) → ℂ)) =
        Set.range (Pi.basisFun ℂ (Fin (r + r + r))) by
      ext x; simp [Pi.basisFun_apply]]
    exact (Pi.basisFun ℂ (Fin (r + r + r))).span_eq
  · intro c₀ c₁ c₂ h0 h1 h2 hrel
    exact hind c₀ c₁ c₂ (Kspan_isAlgebraic L.isAlgebraic_α hb.alg h0)
      (Kspan_isAlgebraic L.isAlgebraic_α hb.alg h1) (Kspan_isAlgebraic L.isAlgebraic_α hb.alg h2) hrel

end CM4E.AbVar
