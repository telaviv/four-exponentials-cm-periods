/-!
# Theorem SE, part (SE₀): strong elliptic four exponentials at `t = cη/Ω`

Paper addition seed 2 (`schanuel/five_exp/pilot_harvest1/PAPER_ADDITION_2_SE.md`, §1, Theorem `thm:SE` (3); now
Theorem 4.12(3) of `paper_cm/paper.tex` §4.3): let `E` be a CM curve over `ℚ̄`, `Ω` a nonzero period, `η = η*(Ω)` the
conjugate-eigen quasi-period, `c ∈ ℚ̄ˣ` and `t = cη/Ω`. If `u₁, u₂ ∈ 𝓛̃_E = ℚ̄ + ℚ̄𝓛_E` and `Ω, u₁, u₂` are linearly
independent over `ℚ̄`, then `tu₁, tu₂` are not both in `ℚ̄𝓛_E + ℚ̄·Fib_E`, where `Fib_E` is the set of fibre coordinates
of logarithms of `E^♮(ℚ̄)` (it contains `ℚ̄`, the values `ζ*(u)`, `u ∈ 𝓛_E`, and `η`).

Here `E = E_L` for a `CMLattice` `L = Ω ℤ[α]` with `κ₁ = 0` (`KappaOneZero L`: `ζ(αz) = ᾱζ(z)`, so the standard `ζ` is
the conjugate-eigen `ζ*` and `η*(Ω) = η(Ω) = L.η₀`; true for `ϖℤ[i]` and `Ω_ρℤ[ρ]`; `κ₁ = 0` forces `α` to be a unit, so these general statements cover
exactly the curves with `j ∈ {0, 1728}`, `reviews/REFEREE_HYP_SE0.md` #13). `Fib_E` is `FibE L`: the `w` with
`(u, w) ∈ Λ(E^♮)` for some `u`, in the coordinates `exp(u, w) = (℘(u), ℘'(u), w − ζ(u))` (`MX.LogNat` with the
quasi-periods `etaL L m n = (m + nᾱ)η₀ = η((m + nα)Ω)`, as in `Gen.KFib`). `thmSE0` is conditional on W88 §5d for the
groups below (`Thm11KappaSE0`), on `η₀/Ω ∉ ℚ̄`, and on complex multiplication acting on elliptic logarithms
(`Bridge.CMMulLogE`). `CM4E/Bridge/SE0.lean` proves the first two from `lean_lsg` (`κ₁ = 0`, algebraic invariants).

## The group (the §5d hyperplane route)

The paper uses `G = G_a × E × E × E^♮`, `Ψ = (a + z₁, z₂ + w)` (`w` the fibre coordinate of `E^♮`, its base coordinate
not read), `V = ℂ(1, t)`. As in `CM4E/AbVar/SE.lean` the `K`-structure is explicit: `K ⊇ k = ℚ(α)` a number field
containing `c` and all coefficients, `γ` a `k`-basis of `K` (`r = [K : k] ≥ 2`, `n = 2r`), `θ = (γ_j, αγ_j)`. The
paper's `G'' = G^n/U = G_a × A₁ × A₂ × Q` is replaced by the isogenous group `G_a × E^r × E^r × (E^r)^♮_γ`, where
`(E^r)^♮_γ` is the push-out of `(E^r)^♮` along the row `γ` (fibre coordinate `s = Σ_j γ_j w_j`, one dimension): base
coordinates `ℂ^{r + r + r}` (blocks `b1`, `b2`, `b3`), `G_a`-coordinate `s₁`, fibre coordinate `s₂`. Slot forms
`μ₁ = Σ_j γ_j z_{b1 j}`, `μ₂ = Σ_j γ_j z_{b2 j}`, `Ψ'' = (μ₁ + s₁, μ₂ + s₂)` (frame `CM4E/AbVar/FrameX0.lean`, `d₀ = 1`,
`d₂ = 3r + 1`). A `K`-multiple `x·v` of an elliptic logarithm is lifted to block 1 or 2 as in Theorem SE (`eLiftB`).
A `K`-multiple `x·w` of a fibre coordinate (`(u, w) ∈ Λ(E^♮)`) is lifted to block 3 by writing
`x = Σ_j (a_j + b_j α)γ_j = Σ_j ((a_j + q b_j) − b_j ᾱ)γ_j` (`ᾱ = q − α`): the lift is
`Σ_j (a_j + q b_j)(u, w)e_{b3 j} − b_j (αu, ᾱw)e_{b3 j}` (`vLiftB`), where `(αu, ᾱw) ∈ Λ(E^♮)` by complex multiplication
and `κ₁ = 0` (`logNat_mul`). Data: one period family `θ_h(Ω, cη) = θ_hΩ(1, t)` (the period `(Ω, η)` of `E^♮` in block 3)
and two data families `θ_h(u_j, tu_j)`: `m = 3n`, `κ ≥ n`, and (5.4) reads `3n > 2(3r + 1) − n`, i.e. `r ≥ 2`.

Soundness of the model `gmESV L a₁ a₂ cM` (not checked by Lean): it is the model of `G_a × ((E^m)^♮` pushed out along
the row `cM`) with `G_a` in `d₀` (`d₀ = 1`, `d₁ = 0`, `d₂ = m + 1`), coordinates `(z, s₁, s₂)` (base, `G_a`, fibre
`s₂ = Σ_j cM_j w_j`), algebraic vectors `ℚ̄^m × ℚ̄²`, logarithms generated by the images `(u e_j, 0, cM_j w)` of the
logarithms `(u e_j, w e_j)` of `(E^m)^♮` (`(u, w) ∈ Λ(E^♮)`, `MX.LogNat` with `etaL L`, which is `Λ(E^♮)` when `κ₁ = 0`)
and by `G_a`- and fibre vectors with algebraic coordinates, periods generated by the images `(λ e_j, 0, cM_j η(λ))` of the
periods of `(E^m)^♮` (`λ = aΩ + bαΩ`, `η(λ) = etaL L a b` when `κ₁ = 0`). Its `sub` is the uniform subgroup condition.
This is the standard model `gmStdVec 1 0 (fun _ => L.pp) M` (`M` the row `cM`) of `CM4E/Bridge/StdVec.lean` in other
coordinates; the reduction, including the uniform subgroup condition for `gmSE0` (a connected subgroup `Γ + T_{B̃}` with
`Γ ≠ 0` has an algebraic `(a, s) ≠ 0` with `Ψ'' = (a, s)`; with `B ≠ 0` it contains `(λ, 0)` and `(0, γ·η(λ))` for a
nonzero lattice point `λ` of `T_B`, and `μ₁, μ₂, Σ γ_j η(λ_{b3 j})` do not all vanish by the `k`-independence of `γ`), is
*proved* in `CM4E/Bridge/SE0.lean`, so for the unconditional theorem only the soundness of `gmStdVec` (the statement of
`lean_lsg`'s Theorem 4.1 for vector extensions) is used.
-/

open Complex Module CM4E.Waldschmidt CM4E.Gen CM4E.MX IntermediateField

namespace CM4E.AbVar

/-! ## `Fib_E` and `ℚ̄𝓛_E + ℚ̄·Fib_E` -/

/-- **`Fib_E`**: the fibre coordinates `w` of logarithms `(u, w)` of algebraic points of `E^♮` (`E = E_L`), in the
coordinates `exp(u, w) = (℘(u), ℘'(u), w − ζ(u))`: either `u = aΩ + bαΩ` is a period and `w − η(u) ∈ ℚ̄`
(`η(u) = etaL L a b`), or `℘(u), ℘'(u) ∈ ℚ̄` and `w − ζ(u) ∈ ℚ̄`. -/
def FibE (L : CMLattice) : Set ℂ := {w | ∃ u, LogNat L.pp (etaL L) u w}

/-- **`ℚ̄𝓛_E + ℚ̄·Fib_E`**. -/
def QbarLFib (L : CMLattice) : Set ℂ :=
  {z | ∃ (N N' : ℕ) (β v : Fin N → ℂ) (β' w : Fin N' → ℂ), (∀ k, IsAlgebraic ℚ (β k)) ∧
    (∀ k, LogE L.pp (v k)) ∧ (∀ k, IsAlgebraic ℚ (β' k)) ∧ (∀ k, w k ∈ FibE L) ∧
    z = ∑ k, β k * v k + ∑ k, β' k * w k}

lemma algebraic_mem_FibE (L : CMLattice) {w : ℂ} (hw : IsAlgebraic ℚ w) : w ∈ FibE L :=
  ⟨0, Or.inl ⟨0, 0, by simp, by simpa [etaL] using hw⟩⟩

lemma eta_mem_FibE (L : CMLattice) : L.η₀ ∈ FibE L :=
  ⟨L.ω, Or.inl ⟨1, 0, by simp [L.hω₁], by simp [etaL, isAlgebraic_zero]⟩⟩

/-- `𝓛̃_E ⊂ ℚ̄𝓛_E + ℚ̄·Fib_E` (`ℚ̄ ⊂ Fib_E`). -/
lemma LtildeE_subset_QbarLFib (L : CMLattice) : LtildeE L.pp ⊆ QbarLFib L := by
  rintro z ⟨N, β₀, β, v, hβ₀, hβ, hv, rfl⟩
  refine ⟨N, 1, β, v, fun _ => 1, fun _ => β₀, hβ, hv, fun _ => isAlgebraic_one,
    fun _ => algebraic_mem_FibE L hβ₀, ?_⟩
  simp [add_comm]

/-! ## The model of `G_a × ((E^m)^♮` pushed out along a row`)` -/

variable {m : ℕ}

/-- `(u e_j, 0, cM_j w)`: the image of the logarithm `(u e_j, w e_j)` of `(E^m)^♮`. -/
noncomputable def genV (cM : Fin m → ℂ) (j : Fin m) (u w : ℂ) : TX (Fin m → ℂ) := (Pi.single j u, 0, cM j * w)

/-- Generators of the logarithms: images of logarithms of `(E^m)^♮` and algebraic `G_a`- and fibre vectors. -/
def lamESV (L : CMLattice) (cM : Fin m → ℂ) : Set (TX (Fin m → ℂ)) :=
  {x | ∃ j u w, LogNat L.pp (etaL L) u w ∧ x = genV cM j u w} ∪
    {x | ∃ c₁ c₂ : ℂ, IsAlgebraic ℚ c₁ ∧ IsAlgebraic ℚ c₂ ∧ x = (0, c₁, c₂)}

/-- Generators of the periods: `(λ e_j, 0, cM_j η(λ))`, `λ = aΩ + bαΩ`. -/
def perESV (L : CMLattice) (cM : Fin m → ℂ) : Set (TX (Fin m → ℂ)) :=
  {x | ∃ (j : Fin m) (a b : ℤ), x = genV cM j (a * L.pp.ω₁ + b * L.pp.ω₂) (etaL L a b)}

/-- **The model of `G_a × ((E_L^m)^♮` pushed out along the row `cM`)** with slot forms `μ_i = Σ_j a_i(j) z_j`. -/
noncomputable def gmESV (L : CMLattice) (a₁ a₂ cM : Fin m → ℂ) : GroupModel (TX (Fin m → ℂ)) :=
  gmFX0 algVF (lamESV L cM) (perESV L cM) (dotL a₁) (dotL a₂)

lemma PsiX_genV (a₁ a₂ cM : Fin m → ℂ) (j : Fin m) (u w : ℂ) :
    PsiX (dotL a₁) (dotL a₂) (genV cM j u w) = (a₁ j * u, a₂ j * u + cM j * w) := by
  simp [PsiX_apply, genV, dotL_single]

lemma perESV_subset_lamESV (L : CMLattice) (cM : Fin m → ℂ) : perESV L cM ⊆ lamESV L cM := by
  rintro _ ⟨j, a, b, rfl⟩
  exact Or.inl ⟨j, _, _, Or.inl ⟨a, b, rfl, by simp [isAlgebraic_zero]⟩, rfl⟩

lemma genE_eq_genV {cM : Fin m → ℂ} {j : Fin m} (hj : cM j = 0) (u w : ℂ) : genE j u = genV cM j u w := by
  simp [genE, genV, hj]

/-! ## Logarithms of `E^♮` -/

/-- An elliptic logarithm is the base of a logarithm of `E^♮`. -/
lemma logNat_of_logE (L : CMLattice) {v : ℂ} (h : LogE L.pp v) : ∃ w, LogNat L.pp (etaL L) v w := by
  by_cases hv : v ∈ L.pp.lattice
  · obtain ⟨a, b, hab⟩ := PeriodPair.mem_lattice.mp hv
    exact ⟨etaL L a b, Or.inl ⟨a, b, hab.symm, by simp [isAlgebraic_zero]⟩⟩
  · rcases h with h | ⟨h1, h2⟩
    · exact absurd h hv
    · exact ⟨CM4E.Ext.Weierstrass.zeta L.pp v, Or.inr ⟨hv, h1, h2, by simp [isAlgebraic_zero]⟩⟩

lemma isAlgebraic_conj_α (L : CMLattice) : IsAlgebraic ℚ (starRingEnd ℂ L.α) := by
  rw [L.conj_α]
  exact (isAlgebraic_algebraMap (L.q : ℚ)).sub L.isAlgebraic_α

/-- **Complex multiplication on `Λ(E^♮)`**: `(u, w) ↦ (αu, ᾱw)` (`κ₁ = 0`, `αΛ = Λ`). -/
lemma logNat_mul (L : CMLattice) (hκ : KappaOneZero L) (hCM : Bridge.CMMulLogE L) {u w : ℂ}
    (h : LogNat L.pp (etaL L) u w) : LogNat L.pp (etaL L) (L.α * u) (starRingEnd ℂ L.α * w) := by
  have hd := LSG.W88.V5d.CMLat.cmD (Bridge.adaptL L) hκ
  have hω := L.ω_ne_zero
  rcases h with ⟨a, b, rfl, hw⟩ | ⟨hu, h1, h2, hw⟩
  · have hl : L.α * ((a : ℂ) * L.pp.ω₁ + b * L.pp.ω₂) ∈ L.pp.lattice :=
      hd.unit.mul_mem _ (PeriodPair.mem_lattice.mpr ⟨a, b, rfl⟩)
    obtain ⟨a', b', hab⟩ := PeriodPair.mem_lattice.mp hl
    have e : (a' : ℂ) + b' * L.α = L.α * (a + b * L.α) := by
      rw [L.hω₁, L.hω₂] at hab
      apply mul_right_cancel₀ hω
      linear_combination hab
    have e' : (a' : ℂ) + b' * starRingEnd ℂ L.α = starRingEnd ℂ L.α * (a + b * starRingEnd ℂ L.α) := by
      have := congrArg (starRingEnd ℂ) e
      simpa [map_add, map_mul] using this
    refine Or.inl ⟨a', b', hab.symm, ?_⟩
    have : starRingEnd ℂ L.α * w - etaL L a' b' = starRingEnd ℂ L.α * (w - etaL L a b) := by
      simp only [etaL]; rw [e']; ring
    rw [this]
    exact (isAlgebraic_conj_α L).mul hw
  · have hαu : L.α * u ∉ L.pp.lattice := by
      intro hl
      apply hu
      have hne : L.α ≠ 0 := hd.unit.ne
      have := hd.unit.inv_mul_mem _ hl
      rwa [show (Bridge.adaptL L).α = L.α from rfl, ← mul_assoc, inv_mul_cancel₀ hne, one_mul] at this
    obtain hl | ⟨h1', h2'⟩ := hCM u (Or.inr ⟨h1, h2⟩)
    · exact absurd hl hαu
    refine Or.inr ⟨hαu, h1', h2', ?_⟩
    rw [hκ u, ← mul_sub]
    exact (isAlgebraic_conj_α L).mul hw

/-! ## Lifts of `K`-multiples of fibre coordinates -/

variable {r : ℕ}

/-- `x·(u, w)` in block `blk` of `(E^m)^♮`, with `x = Σ_i (a_i + b_i α)γ_i`:
`Σ_i (a_i + q b_i)(u, w)e_{blk i} − b_i(αu, ᾱw)e_{blk i}` (pushed out along `cM`). -/
noncomputable def vLiftB (L : CMLattice) (γ : Fin r → ℂ) (cM : Fin m → ℂ) (blk : Fin r → Fin m) (x u w : ℂ) :
    TX (Fin m → ℂ) :=
  ∑ i, ((coordsA L.α γ x (i, 0) + L.q * coordsA L.α γ x (i, 1)) • genV cM (blk i) u w -
    (coordsA L.α γ x (i, 1)) • genV cM (blk i) (L.α * u) (starRingEnd ℂ L.α * w))

lemma PsiX_vLiftB (L : CMLattice) (γ : Fin r → ℂ) (a₁ a₂ cM : Fin m → ℂ) (blk : Fin r → Fin m) (x u w : ℂ) :
    PsiX (dotL a₁) (dotL a₂) (vLiftB L γ cM blk x u w) =
      (∑ i, a₁ (blk i) * ((((coordsA L.α γ x (i, 0) + L.q * coordsA L.α γ x (i, 1) : ℚ)) : ℂ) * u -
          (coordsA L.α γ x (i, 1) : ℂ) * (L.α * u)),
        ∑ i, (a₂ (blk i) * ((((coordsA L.α γ x (i, 0) + L.q * coordsA L.α γ x (i, 1) : ℚ)) : ℂ) * u -
          (coordsA L.α γ x (i, 1) : ℂ) * (L.α * u)) +
          cM (blk i) * ((((coordsA L.α γ x (i, 0) + L.q * coordsA L.α γ x (i, 1) : ℚ)) : ℂ) * w -
          (coordsA L.α γ x (i, 1) : ℂ) * (starRingEnd ℂ L.α * w)))) := by
  simp only [vLiftB, map_sum, map_sub, PsiX_qsmulF, PsiX_genV]
  refine Prod.ext ?_ ?_
  · simp only [Prod.fst_sum, Prod.fst_sub]
    exact Finset.sum_congr rfl fun i _ => by ring
  · simp only [Prod.snd_sum, Prod.snd_sub]
    exact Finset.sum_congr rfl fun i _ => by ring

/-- `Ψ''` of the block-3 lift in the model of Theorem SE₀: `(0, x·w)`. -/
lemma PsiX_vlift3 (L : CMLattice) {γ'' γ : Fin r → ℂ} {x : ℂ} (hx : x ∈ Kspan L.α γ) (u w : ℂ) :
    PsiX (dotL (aSE1 γ'')) (dotL (aSE2 γ'' 0)) (vLiftB L γ (aSE2 0 γ) b3 x u w) = (0, x * w) := by
  rw [PsiX_vLiftB]
  refine Prod.ext ?_ ?_
  · simp
  dsimp only
  simp only [aSE2_b3, Pi.zero_apply, zero_mul, zero_add]
  rw [← sum_coords hx w]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [L.conj_α]
  push_cast
  ring

lemma vLiftB_mem_lam (L : CMLattice) (hκ : KappaOneZero L) (hCM : Bridge.CMMulLogE L) (γ : Fin r → ℂ)
    (cM : Fin m → ℂ) (blk : Fin r → Fin m) (x : ℂ) {u w : ℂ} (h : LogNat L.pp (etaL L) u w) :
    vLiftB L γ cM blk x u w ∈ Submodule.span ℚ (lamESV L cM) :=
  Submodule.sum_mem _ fun i _ => sub_mem
    (Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨blk i, u, w, h, rfl⟩)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨blk i, _, _, logNat_mul L hκ hCM h, rfl⟩)))

/-- The lift of `x·(Ω, η₀)` is a rational combination of periods. -/
lemma vLiftB_mem_per (L : CMLattice) (γ : Fin r → ℂ) (cM : Fin m → ℂ) (blk : Fin r → Fin m) (x : ℂ) :
    vLiftB L γ cM blk x L.ω L.η₀ ∈ Submodule.span ℚ (perESV L cM) := by
  refine Submodule.sum_mem _ fun i _ => sub_mem (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
  · exact ⟨blk i, 1, 0, by simp [L.hω₁, etaL]⟩
  · exact ⟨blk i, 0, 1, by simp [L.hω₂, etaL]⟩

/-- Block lifts of `K`-multiples of elliptic logarithms on blocks where `cM` vanishes are logarithms. -/
lemma eLiftB_mem_lamESV (L : CMLattice) (hCM : Bridge.CMMulLogE L) (γ : Fin r → ℂ) (cM : Fin m → ℂ)
    (blk : Fin r → Fin m) (hblk : ∀ i, cM (blk i) = 0) (x : ℂ) {v : ℂ} (hv : LogE L.pp v) :
    eLiftB L.α γ blk x v ∈ Submodule.span ℚ (lamESV L cM) := by
  have hgen : ∀ i {v'}, LogE L.pp v' → genE (blk i) v' ∈ lamESV L cM := fun i v' hv' => by
    obtain ⟨w, hw⟩ := logNat_of_logE L hv'
    exact Or.inl ⟨blk i, v', w, hw, genE_eq_genV (hblk i) v' w⟩
  exact Submodule.sum_mem _ fun i _ => add_mem (Submodule.smul_mem _ _ (Submodule.subset_span (hgen i hv)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (hgen i (hCM v hv))))

/-- Block lifts of `x·Ω` on blocks where `cM` vanishes are rational combinations of periods. -/
lemma eLiftB_mem_perESV (L : CMLattice) (γ : Fin r → ℂ) (cM : Fin m → ℂ) (blk : Fin r → Fin m)
    (hblk : ∀ i, cM (blk i) = 0) (x : ℂ) : eLiftB L.α γ blk x L.ω ∈ Submodule.span ℚ (perESV L cM) := by
  refine Submodule.sum_mem _ fun i _ => add_mem (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
  · exact ⟨blk i, 1, 0, by rw [genE_eq_genV (hblk i) _ (etaL L 1 0)]; simp [L.hω₁]⟩
  · exact ⟨blk i, 0, 1, by rw [genE_eq_genV (hblk i) _ (etaL L 0 1)]; simp [L.hω₂]⟩

/-! ## The model of Theorem SE₀ -/

/-- **The model of Theorem SE₀**: `G_a × E^r × E^r × (E^r)^♮_γ` (`μ₁ = γ` on block 1, `μ₂ = γ` on block 2, fibre
`s = Σ_j γ_j w_{b3 j}`). -/
noncomputable def gmSE0 (L : CMLattice) (γ : Fin r → ℂ) : GroupModel (TX (Fin (r + r + r) → ℂ)) :=
  gmESV L (aSE1 γ) (aSE2 γ 0) (aSE2 0 γ)

/-- **The hypothesis for Theorem SE₀**: W88 §5d for `G_a × E^r × E^r × (E^r)^♮_γ` (`E = E_L`), for every adapted basis,
when `κ₁ = 0` and the invariants are algebraic. Proved in `CM4E/Bridge/SE0.lean` (`Bridge.thm11KappaSE0_uncond`). -/
def Thm11KappaSE0 (L : CMLattice) : Prop :=
  KappaOneZero L → IsAlgebraic ℚ L.pp.g₂ → IsAlgebraic ℚ L.pp.g₃ →
    ∀ (r : ℕ) (γ : Fin r → ℂ), IsAdaptedFieldBasis L.α γ → HyperplaneKappa (gmSE0 L γ)

lemma aSE2_zero_b1 (γ : Fin r → ℂ) (i : Fin r) : aSE2 0 γ (b1 i) = 0 := by simp
lemma aSE2_zero_b2 (γ : Fin r → ℂ) (i : Fin r) : aSE2 0 γ (b2 i) = 0 := by simp

/-! ## Theorem SE₀ -/

/-- **Theorem SE, part (SE₀)** (paper addition seed 2, Theorem `thm:SE` (3); `paper_cm` Theorem 4.12(3)), for a CM
lattice `L` with `κ₁ = 0`: for `c ∈ ℚ̄ˣ`, `t = c·η₀/Ω` (`Ω = L.ω`, `η₀ = η*(Ω)`) and `u₁, u₂ ∈ 𝓛̃_{E_L}` with
`Ω, u₁, u₂` linearly independent over `ℚ̄`, the numbers `tu₁, tu₂` are not both in `ℚ̄𝓛_{E_L} + ℚ̄·Fib_{E_L}`.
Hypotheses: W88 §5d for `G_a × E^r × E^r × (E^r)^♮_γ` (`hW`), `κ₁ = 0`, algebraic invariants, complex multiplication on
elliptic logarithms (`hCM`), and `η₀/Ω ∉ ℚ̄` (`hT`). -/
theorem thmSE0 (L : CMLattice) (hW : Thm11KappaSE0 L) (hκ : KappaOneZero L) (hg₂ : IsAlgebraic ℚ L.pp.g₂)
    (hg₃ : IsAlgebraic ℚ L.pp.g₃) (hCM : Bridge.CMMulLogE L) (hT : Transcendental ℚ (L.η₀ / L.ω))
    (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) (u : Fin 2 → ℂ) (hu : ∀ j, u j ∈ LtildeE L.pp)
    (hind : ∀ a₀ a₁ a₂ : ℂ, IsAlgebraic ℚ a₀ → IsAlgebraic ℚ a₁ → IsAlgebraic ℚ a₂ →
      a₀ * L.ω + a₁ * u 0 + a₂ * u 1 = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) :
    ¬ ∀ j, c * L.η₀ / L.ω * u j ∈ QbarLFib L := by
  intro hall
  have hω := L.ω_ne_zero
  choose N β₀ β v hβ₀ hβ hv hu' using hu
  choose N₁ N₂ δ w δ' f hδ hw hδ' hf heq using hall
  choose u' hu'f using hf
  -- the field
  obtain ⟨r, hr2, γ, hb, hS⟩ := exists_adapted_basis L.α L.isAlgebraic_α L.him.ne' ⟨L.p, L.q, L.hquad⟩
    (insert c (Finset.univ.biUnion fun j : Fin 2 =>
      Finset.univ.image (β j) ∪ Finset.univ.image (δ j) ∪ Finset.univ.image (δ' j))) (by
      intro s hs
      simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ,
        true_and] at hs
      rcases hs with rfl | ⟨j, (⟨k, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩⟩
      exacts [hc, hβ j k, hδ j k, hδ' j k])
  have hcK : c ∈ Kspan L.α γ := hS c (by simp)
  have hβK : ∀ j k, β j k ∈ Kspan L.α γ := fun j k => hS _ (by
    simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
    exact Or.inr ⟨j, Or.inl (Or.inl ⟨k, rfl⟩)⟩)
  have hδK : ∀ j k, δ j k ∈ Kspan L.α γ := fun j k => hS _ (by
    simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
    exact Or.inr ⟨j, Or.inl (Or.inr ⟨k, rfl⟩)⟩)
  have hδ'K : ∀ j k, δ' j k ∈ Kspan L.α γ := fun j k => hS _ (by
    simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
    exact Or.inr ⟨j, Or.inr ⟨k, rfl⟩⟩)
  set θ := theta L.α γ with hθ
  have hθalg := theta_isAlgebraic L.isAlgebraic_α hb.alg
  have hθK : ∀ h, θ h ∈ Kspan L.α γ := fun h => Submodule.subset_span ⟨h, rfl⟩
  have hmK : ∀ h {x}, x ∈ Kspan L.α γ → θ h * x ∈ Kspan L.α γ := fun h x hx => hb.mul_mem _ (hθK h) _ hx
  set a₁ := aSE1 γ
  set a₂ := aSE2 γ 0
  set cM := aSE2 0 γ
  -- `σ = t` is transcendental
  set σ := c * L.η₀ / L.ω with hσdef
  have hσ : Transcendental ℚ σ := by
    intro halg
    apply hT
    have : L.η₀ / L.ω = σ / c := by rw [hσdef]; field_simp
    rw [this, ← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr halg) (mem_algebraicClosure_iff.mpr hc)
  -- the period lifts
  let p : Fin r × Fin 2 → TX (Fin (r + r + r) → ℂ) := fun h =>
    eLiftB L.α γ b1 (θ h) L.ω + vLiftB L γ cM b3 (θ h * c) L.ω L.η₀
  have hpp : ∀ h, p h ∈ Submodule.span ℚ (perESV L cM) := fun h =>
    add_mem (eLiftB_mem_perESV L γ cM b1 (aSE2_zero_b1 γ) _) (vLiftB_mem_per L γ cM b3 _)
  have hpl : ∀ h, p h ∈ Submodule.span ℚ (lamESV L cM) := fun h =>
    Submodule.span_mono (perESV_subset_lamESV L cM) (hpp h)
  have hpΨ : ∀ h, PsiX (dotL a₁) (dotL a₂) (p h) = (θ h * L.ω, σ * (θ h * L.ω)) := by
    intro h
    simp only [p, map_add, a₁, a₂, cM, PsiX_lift1 (hθK h), PsiX_vlift3 L (hmK h hcK)]
    refine Prod.ext (by simp) ?_
    simp only [Prod.snd_add, zero_add, hσdef]
    field_simp
  -- the data lifts
  let d : Fin 2 → Fin r × Fin 2 → TX (Fin (r + r + r) → ℂ) := fun j h =>
    ∑ k, eLiftB L.α γ b1 (θ h * β j k) (v j k) + (((0 : Fin (r + r + r) → ℂ), θ h * β₀ j, 0) : _) +
      ∑ k, eLiftB L.α γ b2 (θ h * δ j k) (w j k) + ∑ k, vLiftB L γ cM b3 (θ h * δ' j k) (u' j k) (f j k)
  have hdl : ∀ j h, d j h ∈ Submodule.span ℚ (lamESV L cM) := by
    intro j h
    refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
    · exact Submodule.sum_mem _ fun k _ =>
        eLiftB_mem_lamESV L hCM γ cM b1 (aSE2_zero_b1 γ) _ (hv j k)
    · exact Submodule.subset_span (Or.inr ⟨_, _, (hθalg h).mul (hβ₀ j), isAlgebraic_zero, rfl⟩)
    · exact Submodule.sum_mem _ fun k _ =>
        eLiftB_mem_lamESV L hCM γ cM b2 (aSE2_zero_b2 γ) _ (hw j k)
    · exact Submodule.sum_mem _ fun k _ => vLiftB_mem_lam L hκ hCM γ cM b3 _ (hu'f j k)
  have hdΨ : ∀ j h, PsiX (dotL a₁) (dotL a₂) (d j h) = (θ h * u j, σ * (θ h * u j)) := by
    intro j h
    simp only [d, map_add, map_sum, a₁, a₂, cM, PsiX_lift1 (hmK h (hβK j _)), PsiX_lift2 (hmK h (hδK j _)),
      PsiX_vlift3 L (hmK h (hδ'K j _)), PsiX_ga]
    refine Prod.ext ?_ ?_
    · simp only [Prod.fst_add, Prod.fst_sum, Finset.sum_const_zero, add_zero]
      rw [hu' j, mul_add, Finset.mul_sum, add_comm]
      congr 1
      exact Finset.sum_congr rfl fun k _ => by ring
    · simp only [Prod.snd_add, Prod.snd_sum, Finset.sum_const_zero, zero_add]
      rw [show σ * (θ h * u j) = θ h * (σ * u j) by ring, hσdef, heq j, mul_add, Finset.mul_sum,
        Finset.mul_sum]
      congr 1
      · exact Finset.sum_congr rfl fun k _ => by ring
      · exact Finset.sum_congr rfl fun k _ => by ring
  -- algebraicity of the slot forms
  have ha₁ : ∀ j, IsAlgebraic ℚ (a₁ j) :=
    forall_blocks (P := fun j => IsAlgebraic ℚ (a₁ j)) (fun i => by simpa [a₁] using hb.alg i)
      (fun i => by simp [a₁, isAlgebraic_zero]) (fun i => by simp [a₁, isAlgebraic_zero])
  have ha₂ : ∀ j, IsAlgebraic ℚ (a₂ j) :=
    forall_blocks (P := fun j => IsAlgebraic ℚ (a₂ j)) (fun i => by simp [a₂, isAlgebraic_zero])
      (fun i => by simpa [a₂] using hb.alg i) (fun i => by simp [a₂, isAlgebraic_zero])
  have hμ : ∀ a : Fin (r + r + r) → ℂ, (∀ j, IsAlgebraic ℚ (a j)) →
      ∀ q, algVF q → IsAlgebraic ℚ (dotL a q) := by
    intro a ha q hq
    rw [dotL_apply, ← mem_algebraicClosure_iff]
    exact sum_mem fun j _ => mul_mem (mem_algebraicClosure_iff.mpr (ha j)) (mem_algebraicClosure_iff.mpr (hq j))
  refine frameX0_false (dotL a₁) (dotL a₂) θ hb.indep algVF (lamESV L cM) (perESV L cM)
    (hW hκ hg₂ hg₃ r γ hb) (by simp; omega) (hμ a₁ ha₁) (hμ a₂ ha₂)
    (Set.range fun j => (Pi.single j (1 : ℂ) : Fin (r + r + r) → ℂ)) ?_ ?_ σ hσ L.ω (u 0) (u 1) ?_
    p hpl hpp hpΨ (d 0) (d 1) (hdl 0) (hdl 1) (hdΨ 0) (hdΨ 1)
  · rintro _ ⟨j, rfl⟩ k
    simp only [Pi.single_apply]
    split_ifs
    exacts [isAlgebraic_one, isAlgebraic_zero]
  · rw [show (Set.range fun j => (Pi.single j (1 : ℂ) : Fin (r + r + r) → ℂ)) =
        Set.range (Pi.basisFun ℂ (Fin (r + r + r))) by
      ext x; simp [Pi.basisFun_apply]]
    exact (Pi.basisFun ℂ (Fin (r + r + r))).span_eq
  · intro c₀ c₁ c₂ h0 h1 h2 hrel
    exact hind c₀ c₁ c₂ (Kspan_isAlgebraic L.isAlgebraic_α hb.alg h0)
      (Kspan_isAlgebraic L.isAlgebraic_α hb.alg h1) (Kspan_isAlgebraic L.isAlgebraic_α hb.alg h2) hrel

end CM4E.AbVar
