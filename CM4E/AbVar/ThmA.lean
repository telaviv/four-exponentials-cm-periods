import Mathlib
import CM4E.Common
import CM4E.AbVar.Basis
import CM4E.AbVar.Fermat7
import CM4E.AbVar.X7
import CM4E.Gen.Frame
import CM4E.Gen.FrameW

/-!
# Theorem MG-A: four exponentials at `cP/π` and `cπ/P` for CM abelian eigen-periods (paper, `thm:MGA`)

Let `ζ = e^{2πi/N}`, `F = ℚ(ζ)` (`d = φ(N)`), and let `A` be a simple CM abelian variety of dimension `g` with CM by `F`,
with eigen-coordinates `z_s` (`s < g`) on which `[ζ]` acts by `ζ^{κ s}`, and a cycle `γ` with `z_s(γ) = P s`. Fix a slot
`s₀` with `κ s₀ = 1`. For an `F`-basis `b` of a number field `K` (`θ(j, e) = ζ^e b j`, `n = d r`) the group of the proof
is `G'' = G_m^{2n} × A^r`, written in eigen-coordinates `q (s, j)` (copy `j`, coordinate `s`), with linear form
`λ(q) = Σ_j b_j q (s₀, j)` (frame `gmF` of `CM4E/Gen/Frame.lean`, `d₂ = g r = gn/d`; for a genuine instance `2g = d`, and the
proof only needs `2g ≤ d`, so `d₂ < n`).
Its periods are generated by the copies `[ζ^e]γ` (coordinates `ζ^{κ s · e} P s`).

`fourExpAt_A`: `FourExpAt (cP_{s₀}/π)` for every algebraic `c ≠ 0`, assuming W88 §5d for these groups and
`P_{s₀}/π ∉ ℚ̄`; `fourExpAt_inv` then gives `FourExpAt (cπ/P_{s₀})` (stated for `B(1/5, 1/5)`). The second assumption
is itself a corollary of the first (`transcendental_div_pi_of_thm11KappaA`, a rational hyperplane through one period
lift, lean_lsg ABVAR.md §1.6), so the instance theorems assume only `Thm11KappaA`. The families `cP`, `c/P`
need the second-kind slot: `CM4E/AbVar/ThmAn.lean`.

Soundness of `gmA` (not checked by Lean; per instance): `A` simple CM with the stated `κ`, `P`; `G_m^{2n} × A^r` is a
product with connected subgroups `T_L × B`; a nonzero abelian subvariety `B ⊂ A^r` (an `F`-subspace `S ⊂ F^r`) has
`λ ≠ 0` on `T(B) = ⊕_s σ_s(S) ⊗ ℂ`, because `Σ_j b_j m_j = 0` with `m ∈ F^r` forces `m = 0`.

The instance `y⁵ = x(1 − x)` (`N = 5`, `g = 2`, `κ = (1, 2)`, `P s = (1 − ζ^{s+1}) B((s+1)/5, (s+1)/5)`) gives
`FourExpAt (c B(1/5, 1/5)/π)`, e.g. `2^t, 3^t` are not both algebraic at `t = Γ(1/5)²/(πΓ(2/5))` (`two_three_beta5`).
-/

open Complex Module CM4E.Waldschmidt CM4E.Gen

namespace CM4E.AbVar

/-- `FourExpAt t` implies `FourExpAt t⁻¹`. -/
lemma fourExpAt_inv {t : ℂ} (ht : FourExpAt t) (ht0 : t ≠ 0) : FourExpAt t⁻¹ := by
  intro a b ha hb hind ⟨h1, h2⟩
  refine ht (t⁻¹ * a) (t⁻¹ * b) h1 h2 ?_ ⟨?_, ?_⟩
  · rw [LinearIndependent.pair_iff] at hind ⊢
    intro s u h
    apply hind s u
    have : t⁻¹ * (s • a + u • b) = 0 := by
      rw [← h]; simp only [Rat.smul_def]; ring
    exact (mul_eq_zero.mp this).resolve_left (inv_ne_zero ht0)
  · rw [← mul_assoc, mul_inv_cancel₀ ht0, one_mul]; exact ha
  · rw [← mul_assoc, mul_inv_cancel₀ ht0, one_mul]; exact hb

/-- `ζ_N = e^{2πi/N}`. -/
noncomputable def zetaN (N : ℕ) : ℂ := Complex.exp (2 * Real.pi * I / N)

lemma zetaN_prim (N : ℕ) (hN : N ≠ 0) : IsPrimitiveRoot (zetaN N) N := by
  simpa [zetaN] using Complex.isPrimitiveRoot_exp N hN

lemma isAlgebraic_zetaN (N : ℕ) (hN : N ≠ 0) : IsAlgebraic ℚ (zetaN N) :=
  ⟨Polynomial.X ^ N - Polynomial.C 1, Polynomial.X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero hN) 1,
    by simp [(zetaN_prim N hN).pow_eq_one]⟩

lemma natDegree_minpoly_zetaN (N : ℕ) (hN : N ≠ 0) : (minpoly ℚ (zetaN N)).natDegree = N.totient := by
  rw [← Polynomial.cyclotomic_eq_minpoly_rat (zetaN_prim N hN) (Nat.pos_of_ne_zero hN),
    Polynomial.natDegree_cyclotomic]

variable (N g : ℕ) (κ : Fin g → ℕ) (P : Fin g → ℂ) (s₀ : Fin g) {r : ℕ} (b : Fin r → ℂ)

/-- `θ'(s, j) = b_j` on the slot `s₀`, `0` elsewhere: `λ = θ'ᵀ`. -/
def thetaA : Fin g × Fin r → ℂ := fun p => if p.1 = s₀ then b p.2 else 0

/-- Generators of the periods of `A^r`: `[ζ^e]γ` in copy `j`. -/
noncomputable def perAgen : Set (Fin g × Fin r → ℂ) :=
  Set.range (fun je : Fin r × ℕ => fun p => if p.2 = je.1 then zetaN N ^ (κ p.1 * je.2) * P p.1 else 0)

/-- The `ℚ̄`-structure of `T(A^r)`. -/
def algA (q : Fin g × Fin r → ℂ) : Prop := ∀ p, IsAlgebraic ℚ (q p)

/-- **The model of `G_m^{2n} × A^r`.** -/
noncomputable def gmA : GroupModel (TF (Fin r × Fin N.totient) (Fin g × Fin r → ℂ)) :=
  gmF (algA g) (perAgen N g κ P) (dotL (thetaA g s₀ b))

/-- **The hypothesis for Theorem MG-A**: W88 §5d for `G_m^{2n} × A^r`, for every `F`-basis `b` of a number field,
restricted to the toric-injective hyperplanes (`TorInj`: no nonzero period of `A^r` alone lies in `V`). The restriction
only weakens the hypothesis (`HyperplaneKappa.on`); the proof uses it only at `V''`, which is toric-injective
(`perA_inj`). -/
def Thm11KappaA : Prop :=
  ∀ (r : ℕ) (b : Fin r → ℂ), IsAdaptedBasisD (zetaN N) N.totient b →
    HyperplaneKappaOn (gmA N g κ P s₀ b) (TorInj (gmA N g κ P s₀ b))

/-- The coordinates of a vector of `span_ℚ perAgen`: `q (s, j) = P s · f_j(ζ^{κ s})` for rational polynomials `f_j`
(`[ζ^e]γ` in copy `j` is `f_j = X^e`). -/
lemma perA_poly {q : Fin g × Fin r → ℂ} (hq : q ∈ Submodule.span ℚ (perAgen N g κ P)) :
    ∃ f : Fin r → Polynomial ℚ, ∀ p, q p = P p.1 * Polynomial.aeval (zetaN N ^ κ p.1) (f p.2) := by
  induction hq using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨j, e⟩, rfl⟩ := hx
    refine ⟨fun j' => if j' = j then Polynomial.X ^ e else 0, fun p => ?_⟩
    by_cases h : p.2 = j
    · simp [h, pow_mul]; ring
    · simp [h]
  | zero => exact ⟨0, fun p => by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨f, hf⟩ := hx
    obtain ⟨f', hf'⟩ := hy
    exact ⟨f + f', fun p => by simp [hf, hf', mul_add]⟩
  | smul c x _ hx =>
    obtain ⟨f, hf⟩ := hx
    refine ⟨c • f, fun p => ?_⟩
    simp only [Pi.smul_apply, hf, map_smul, Rat.smul_def]
    ring

/-- **`λ` is injective on the periods of `A^r`** (so `V''` is toric-injective). If `Σ_j b_j f_j(ζ) = 0` then every
`f_j(ζ) = 0` (`ℚ`-independence of `θ(j, e) = ζ^e b_j`), so `Φ_N ∣ f_j` and `f_j(ζ^{κ s}) = 0` for every `s`, as every
`κ s` is prime to `N`. -/
lemma perA_inj (hN : N ≠ 0) (hb : IsAdaptedBasisD (zetaN N) N.totient b) (hκ : κ s₀ = 1)
    (hκN : ∀ s, (κ s).Coprime N) (hP : P s₀ ≠ 0) :
    ∀ q ∈ Submodule.span ℚ (perAgen N g κ P), dotL (thetaA g s₀ b) q = 0 → q = 0 := by
  intro q hq hl
  obtain ⟨f, hf⟩ := perA_poly N g κ P hq
  set Φ := Polynomial.cyclotomic N ℚ with hΦ
  have hmon : Φ.Monic := Polynomial.cyclotomic.monic N ℚ
  have hdeg : Φ.natDegree = N.totient := Polynomial.natDegree_cyclotomic N ℚ
  have ht0 : 0 < N.totient := Nat.totient_pos.mpr (Nat.pos_of_ne_zero hN)
  have hΦ1 : Φ ≠ 1 := fun h => by rw [h, Polynomial.natDegree_one] at hdeg; omega
  have hroot : ∀ k, k.Coprime N → Polynomial.aeval (zetaN N ^ k) Φ = 0 := by
    intro k hk
    have := ((zetaN_prim N hN).pow_of_coprime k hk).isRoot_cyclotomic (Nat.pos_of_ne_zero hN)
    rw [hΦ, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map, Polynomial.map_cyclotomic]
    exact this
  -- `λ(q) = P_{s₀} Σ_j b_j f_j(ζ)`
  have hl' : ∑ j, b j * Polynomial.aeval (zetaN N) (f j) = 0 := by
    have : dotL (thetaA g s₀ b) q = P s₀ * ∑ j, b j * Polynomial.aeval (zetaN N) (f j) := by
      rw [dotL_apply, Fintype.sum_prod_type, Finset.sum_eq_single s₀]
      · rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp [thetaA, hf, hκ]
        ring
      · intro s _ hs
        simp [thetaA, hs]
      · simp
    rw [this] at hl
    exact (mul_eq_zero.mp hl).resolve_left hP
  -- reduce mod `Φ_N` and use the independence of `θ`
  have hR : ∀ j, Polynomial.aeval (zetaN N) (f j) =
      ∑ k : Fin N.totient, ((f j %ₘ Φ).coeff k : ℂ) * zetaN N ^ (k : ℕ) := by
    intro j
    have h1 : Polynomial.aeval (zetaN N) Φ = 0 := by simpa using hroot 1 (Nat.coprime_one_left N)
    rw [← Polynomial.aeval_modByMonic_eq_self_of_root h1,
      Polynomial.aeval_eq_sum_range' (n := N.totient) (by
        rw [← hdeg]; exact Polynomial.natDegree_modByMonic_lt _ hmon hΦ1), Finset.sum_range]
    simp [Algebra.smul_def]
  have hzero := Fintype.linearIndependent_iff.mp hb.indep (fun p => (f p.1 %ₘ Φ).coeff p.2) (by
    rw [Fintype.sum_prod_type, ← hl']
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hR j, Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [thetaD, Rat.smul_def]
    ring)
  have hdvd : ∀ j, Φ ∣ f j := by
    intro j
    rw [← Polynomial.modByMonic_eq_zero_iff_dvd hmon]
    ext k
    by_cases hk : k < N.totient
    · simpa using hzero (j, ⟨k, hk⟩)
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt, Polynomial.coeff_zero]
      have := Polynomial.natDegree_modByMonic_lt (f j) hmon hΦ1
      omega
  funext p
  obtain ⟨u, hu⟩ := hdvd p.2
  rw [hf p, hu, map_mul, hroot _ (hκN p.1), zero_mul, mul_zero]
  rfl

lemma exists_adapted_basisN (hN : N ≠ 0) (S : Finset ℂ) (hS : ∀ s ∈ S, IsAlgebraic ℚ s) :
    ∃ r : ℕ, 1 ≤ r ∧ ∃ b : Fin r → ℂ, IsAdaptedBasisD (zetaN N) N.totient b ∧
      ∀ s ∈ S, s ∈ KspanD (zetaN N) N.totient b := by
  have h := exists_adapted_basisD (zetaN N) (isAlgebraic_zetaN N hN) S hS
  rw [natDegree_minpoly_zetaN N hN] at h
  exact h

/-- If `1, μ` would be dependent over the field `K = span_ℚ θ`, then `μ ∈ K`. -/
lemma adapted_mu_indep {α μ : ℂ} {d r : ℕ} {b : Fin r → ℂ} (hb : IsAdaptedBasisD α d b) (hμ : μ ∉ KspanD α d b) :
    ∀ A ∈ KspanD α d b, ∀ B ∈ KspanD α d b, A + μ * B = 0 → B = 0 := by
  intro A hA B hB h
  by_contra hB0
  apply hμ
  have : μ = -A * B⁻¹ := by field_simp; linear_combination h
  rw [this]
  exact hb.mul_mem _ (neg_mem hA) _ (hb.inv_mem _ hB)

/-- An algebraic number outside `K = span_ℚ θ`: `ζ_p` for a prime `p` with `p − 1 > [K:ℚ]` (its powers
`1, …, ζ_p^{p−2}` are `ℚ`-independent and would lie in `K`). -/
lemma exists_not_mem_KspanD {α : ℂ} {d r : ℕ} {b : Fin r → ℂ} (hb : IsAdaptedBasisD α d b) :
    ∃ μ : ℂ, IsAlgebraic ℚ μ ∧ μ ∉ KspanD α d b := by
  obtain ⟨p, hp_ge, hp⟩ := Nat.exists_infinite_primes (r * d + 2)
  have hp0 : p ≠ 0 := hp.ne_zero
  refine ⟨zetaN p, isAlgebraic_zetaN p hp0, fun hμ => ?_⟩
  have hpow : ∀ k : ℕ, zetaN p ^ k ∈ KspanD α d b := by
    intro k
    induction k with
    | zero => simpa using hb.one_mem
    | succ k ih => rw [pow_succ]; exact hb.mul_mem _ ih _ hμ
  let f : Fin (minpoly ℚ (zetaN p)).natDegree → KspanD α d b := fun i => ⟨zetaN p ^ (i : ℕ), hpow i⟩
  have hf : LinearIndependent ℚ f :=
    LinearIndependent.of_comp (KspanD α d b).subtype (linearIndependent_pow (K := ℚ) (zetaN p))
  have : FiniteDimensional ℚ (KspanD α d b) := FiniteDimensional.span_of_finite ℚ (Set.finite_range _)
  have h1 := hf.fintype_card_le_finrank
  have h2 : finrank ℚ (KspanD α d b) = Fintype.card (Fin r × Fin d) := finrank_span_eq_card hb.indep
  rw [Fintype.card_fin, natDegree_minpoly_zetaN p hp0, Nat.totient_prime hp, h2, Fintype.card_prod,
    Fintype.card_fin, Fintype.card_fin] at h1
  omega

/-- **`P_{s₀}/π ∉ ℚ̄` from the hypothesis of Theorem MG-A** (lean_lsg ABVAR.md §1.6). If `P_{s₀} = απ` with `α ∈ ℚ̄`,
the hyperplane `V = W = ker (λ(q) − aθᵀx − aμθᵀy)` (`a = α/(2i)`, `μ ∈ ℚ̄ ∖ K`) contains the period lift
`(2πi e_{(0,0)}, 0; [ζ⁰]γ)`, and `(5.4)` holds with `m = 1`; but `V` contains no `T_L × B ≠ 0` (`Gen.frameW_false`).
`V` is toric-injective by `perA_inj`. -/
theorem transcendental_div_pi_of_thm11KappaA (hN : N ≠ 0) (hW : Thm11KappaA N g κ P s₀) (hκ : κ s₀ = 1)
    (hκN : ∀ s, (κ s).Coprime N) (hP : P s₀ ≠ 0) : Transcendental ℚ (P s₀ / Real.pi) := by
  intro hα
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  obtain ⟨r, hr, b, hb, -⟩ := exists_adapted_basisN N hN ∅ (by simp)
  obtain ⟨μ, hμalg, hμK⟩ := exists_not_mem_KspanD hb
  have ht0 : 0 < N.totient := Nat.totient_pos.mpr (Nat.pos_of_ne_zero hN)
  set j0 : Fin r := ⟨0, by omega⟩
  have hθ'alg : ∀ p, IsAlgebraic ℚ (thetaA g s₀ b p) := by
    intro p; unfold thetaA; split_ifs
    exacts [hb.alg _, isAlgebraic_zero]
  refine frameW_false (thetaD (zetaN N) N.totient b) hb.indep
    (thetaD_isAlgebraic (isAlgebraic_zetaN N hN) N.totient hb.alg) (algA g) (perAgen N g κ P)
    (dotL (thetaA g s₀ b)) (hW r b hb) (fun q hq => isAlgebraic_dotL hθ'alg hq) (fun _ => isAlgebraic_zero)
    _ (span_range_single _) (by rintro _ ⟨p, rfl⟩ k; exact isAlgebraic_single p k)
    μ hμalg (adapted_mu_indep hb hμK) (P s₀ / Real.pi) hα (div_ne_zero hP hpi)
    (torInj_ker_phiW _ _ _ _ _ _ (perA_inj N g κ P s₀ b hN hb hκ hκN hP))
    (j0, ⟨0, ht0⟩) (fun p => if p.2 = j0 then zetaN N ^ (κ p.1 * 0) * P p.1 else 0) ⟨(j0, 0), rfl⟩ ?_
  rw [dotL_apply, Finset.sum_eq_single (s₀, j0)]
  · simp [thetaA, thetaD]
  · rintro ⟨s, j⟩ - hne
    by_cases hs : s = s₀
    · subst hs
      have : j ≠ j0 := fun h => hne (by rw [h])
      simp [thetaA, this]
    · simp [thetaA, hs]
  · simp

/-- **Theorem MG-A (first-kind slot)**: `FourExpAt (cP/π)` for every algebraic `c ≠ 0`. Hypotheses: W88 §5d for the
groups `G_m^{2n} × A^r` (`hW`), `2g ≤ φ(N)`, `κ s₀ = 1`, every `κ s` prime to `N` (true for a CM type), and
`P_{s₀}/π ∉ ℚ̄`. -/
theorem fourExpAt_A (hN : N ≠ 0) (hW : Thm11KappaA N g κ P s₀) (hg : 2 * g ≤ N.totient) (hκ : κ s₀ = 1)
    (hκN : ∀ s, (κ s).Coprime N)
    (hT : Transcendental ℚ (P s₀ / Real.pi)) (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * P s₀ / Real.pi) := by
  intro x₁ x₂ hx₁ hx₂ hind ⟨ht₁, ht₂⟩
  obtain ⟨r, hr, b, hb, hS⟩ := exists_adapted_basisN N hN {c, I}
    (by intro s hs; simp at hs; rcases hs with rfl | rfl; exacts [hc, isAlgebraic_I])
  have hcK : c ∈ KspanD (zetaN N) N.totient b := hS c (by simp)
  have hIK : I ∈ KspanD (zetaN N) N.totient b := hS I (by simp)
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hθalg := thetaD_isAlgebraic (isAlgebraic_zetaN N hN) N.totient hb.alg
  have ht0 : 0 < N.totient := Nat.totient_pos.mpr (Nat.pos_of_ne_zero hN)
  set j0 : Fin r := ⟨0, by omega⟩
  set i0 : Fin g × Fin r := (s₀, j0)
  have hb0 : b j0 ≠ 0 := by
    have := hb.indep.ne_zero (j0, ⟨0, ht0⟩)
    simpa [thetaD] using this
  have h0 : thetaA g s₀ b i0 ≠ 0 := by simp [thetaA, i0, hb0]
  have hθ'alg : ∀ p, IsAlgebraic ℚ (thetaA g s₀ b p) := by
    intro p; unfold thetaA; split_ifs
    exacts [hb.alg _, isAlgebraic_zero]
  -- the period lifts
  have h2 : (2 : ℂ) ∈ KspanD (zetaN N) N.totient b := by
    have := Submodule.smul_mem _ (2 : ℚ) hb.one_mem
    simpa [Rat.smul_def] using this
  have hxK : ∀ h, 2 * I * c * thetaD (zetaN N) N.totient b h ∈ KspanD (zetaN N) N.totient b := fun h =>
    hb.mul_mem _ (hb.mul_mem _ (hb.mul_mem _ h2 _ hIK) _ hcK) _ (Submodule.subset_span ⟨h, rfl⟩)
  let pv : Fin r × Fin N.totient → (Fin g × Fin r → ℂ) := fun p =>
    fun p' => if p'.2 = p.1 then zetaN N ^ (κ p'.1 * (p.2 : ℕ)) * P p'.1 else 0
  have hpv : ∀ p, dotL (thetaA g s₀ b) (pv p) = thetaD (zetaN N) N.totient b p * P s₀ := by
    intro p
    rw [dotL_apply, Finset.sum_eq_single (s₀, p.1)]
    · simp [thetaA, pv, thetaD, hκ]; ring
    · rintro ⟨s, j⟩ - hne
      by_cases hs : s = s₀
      · subst hs
        have : j ≠ p.1 := fun h => hne (by rw [h])
        simp [thetaA, pv, this]
      · simp [thetaA, hs]
    · simp
  let qh : Fin r × Fin N.totient → (Fin g × Fin r → ℂ) := fun h =>
    ∑ p, (coordsD (zetaN N) N.totient b (2 * I * c * thetaD (zetaN N) N.totient b h) p : ℚ) • pv p
  have hqh : ∀ h, qh h ∈ Submodule.span ℚ (perAgen N g κ P) := fun h =>
    Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨(p.1, p.2), rfl⟩)
  have hlqh : ∀ h, dotL (thetaA g s₀ b) (qh h) =
      c * P s₀ / Real.pi * (2 * Real.pi * I * thetaD (zetaN N) N.totient b h) := by
    intro h
    simp only [qh, map_sum, map_rat_smul, hpv, Rat.smul_def]
    rw [show ∑ p, (coordsD (zetaN N) N.totient b (2 * I * c * thetaD (zetaN N) N.totient b h) p : ℂ) *
        (thetaD (zetaN N) N.totient b p * P s₀) =
        (∑ p, (coordsD (zetaN N) N.totient b (2 * I * c * thetaD (zetaN N) N.totient b h) p : ℂ) *
          thetaD (zetaN N) N.totient b p) * P s₀ by
      rw [Finset.sum_mul]; congr 1; funext p; ring, coordsD_spec (hxK h)]
    field_simp
  -- `s = cP/π` is transcendental
  have hs : Transcendental ℚ (c * P s₀ / Real.pi) := by
    intro halg
    apply hT
    have : P s₀ / Real.pi = (c * P s₀ / Real.pi) / c := by field_simp
    rw [this, ← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr halg) (mem_algebraicClosure_iff.mpr hc)
  have hs0 : c * P s₀ / Real.pi ≠ 0 := fun h => hs (h ▸ isAlgebraic_zero)
  have hindY : LinearIndependent ℚ ![c * P s₀ / Real.pi * x₁, c * P s₀ / Real.pi * x₂] := by
    rw [Fintype.linearIndependent_iff] at hind ⊢
    intro g' hg'
    refine hind g' ?_
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Rat.smul_def] at hg' ⊢
    have : (c * P s₀ / Real.pi) * ((g' 0 : ℂ) * x₁ + (g' 1 : ℂ) * x₂) = 0 := by linear_combination hg'
    exact (mul_eq_zero.mp this).resolve_left hs0
  have hfin : finrank ℂ (Fin g × Fin r → ℂ) < Fintype.card (Fin r × Fin N.totient) := by
    simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_prod, Fintype.card_fin]
    have : g < N.totient := by omega
    nlinarith
  have hP0 : P s₀ ≠ 0 := fun h => hT (by rw [h, zero_div]; exact isAlgebraic_zero)
  refine frame_false_on (thetaD (zetaN N) N.totient b) hb.indep hθalg (algA g) (perAgen N g κ P)
    (dotL (thetaA g s₀ b)) (hW r b hb) (perA_inj N g κ P s₀ b hN hb hκ hκN hP0) hfin (fun _ => isAlgebraic_zero)
    (fun c' q hc' hq p => by simpa using hc'.mul (hq p))
    (Pi.single i0 (thetaA g s₀ b i0)⁻¹)
    (fun p => by
      simp only [Pi.single_apply]; split_ifs
      exacts [(hθ'alg i0).inv, isAlgebraic_zero])
    (by rw [dotL_single]; exact mul_inv_cancel₀ h0)
    (Set.range fun p => ((thetaA g s₀ b i0) • Pi.single p 1 - (thetaA g s₀ b p) • Pi.single i0 1 :
      Fin g × Fin r → ℂ))
    ?_ ?_ _ hs qh hqh hlqh x₁ (c * P s₀ / Real.pi * x₁) x₂ (c * P s₀ / Real.pi * x₂) hx₁ ht₁ hx₂ ht₂
    rfl rfl hindY
  · rintro _ ⟨p, rfl⟩ k
    simp only [Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
    exact ((hθ'alg i0).mul (isAlgebraic_ite _ isAlgebraic_one isAlgebraic_zero)).sub
      ((hθ'alg p).mul (isAlgebraic_ite _ isAlgebraic_one isAlgebraic_zero))
  · apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨p, rfl⟩
      simp [map_sub, map_smul, dotL_single, mul_comm]
    · intro v hv
      rw [LinearMap.mem_ker] at hv
      rw [← decomp_x h0 v hv]
      exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨p, rfl⟩)

/-! ## Instances: `y⁵ = x(1 − x)` and `y⁷ = x(1 − x)` -/

/-- The eigen-periods `P s = (1 − ζ₅^{s+1}) B((s+1)/5, (s+1)/5)` of `Jac(y⁵ = x(1 − x))` (`s = 0, 1`). -/
noncomputable def perA5 (s : Fin 2) : ℂ :=
  (1 - zetaN 5 ^ ((s : ℕ) + 1)) * betaG ((((s : ℕ) + 1 : ℕ) : ℂ) / 5) ((((s : ℕ) + 1 : ℕ) : ℂ) / 5)

/-- `P/π ∉ ℚ̄` for the eigen-period `P = (1 − ζ₅)B(1/5, 1/5)` (Wüstholz 1989; the paper, (W)). Formerly a named input;
now a corollary of the hypothesis of Theorem MG-A (`wuestholzA5_of`). -/
def WuestholzA5 : Prop := Transcendental ℚ (perA5 0 / Real.pi)

/-- `P/π ∉ ℚ̄` for the eigen-period `P = (1 − ζ₇)B(1/7, 1/7)` (Wüstholz 1989). Formerly a named input; now a corollary
of the hypothesis of Theorem MG-A (`wuestholzA7_of`). -/
def WuestholzA7 : Prop := Transcendental ℚ (perT 0 / Real.pi)

lemma one_sub_zetaN_ne (N : ℕ) (hN : 1 < N) : 1 - zetaN N ≠ 0 := by
  intro h
  have := (zetaN_prim N (by omega)).pow_ne_one_of_pos_of_lt one_ne_zero hN
  exact this (by rw [pow_one]; linear_combination -h)

lemma perA5_ne_zero : perA5 0 ≠ 0 := by
  have hz := one_sub_zetaN_ne 5 (by norm_num)
  simp only [perA5, betaG]
  refine mul_ne_zero (by simpa using hz) (div_ne_zero (mul_ne_zero ?_ ?_) ?_) <;>
    exact Gamma_ne_zero_of_re_pos (by norm_num)

/-- **`WuestholzA5` is a corollary of the hypothesis of Theorem MG-A** at `y⁵ = x(1 − x)`. -/
theorem wuestholzA5_of (hW : Thm11KappaA 5 2 (fun s => (s : ℕ) + 1) perA5 0) : WuestholzA5 :=
  transcendental_div_pi_of_thm11KappaA 5 2 (fun s => (s : ℕ) + 1) perA5 0 (by norm_num) hW rfl (by decide)
    perA5_ne_zero

/-- **`WuestholzA7` is a corollary of the hypothesis of Theorem MG-A** at `y⁷ = x(1 − x)`. -/
theorem wuestholzA7_of (hW : Thm11KappaA 7 3 (fun s => (s : ℕ) + 1) perT 0) : WuestholzA7 :=
  transcendental_div_pi_of_thm11KappaA 7 3 (fun s => (s : ℕ) + 1) perT 0 (by norm_num) hW rfl (by decide)
    (perA_ne (j := 1) (by norm_num) (by norm_num))

/-- **Theorem MG-A for `B(1/5, 1/5)`**: `FourExpAt (c B(1/5, 1/5)/π)` for algebraic `c ≠ 0`. -/
theorem fourExpAt_beta5 (hW : Thm11KappaA 5 2 (fun s => (s : ℕ) + 1) perA5 0)
    (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * betaIntegral (1 / 5) (1 / 5) / Real.pi) := by
  have hz := one_sub_zetaN_ne 5 (by norm_num)
  have hB : betaIntegral (1 / 5) (1 / 5) = perA5 0 / (1 - zetaN 5) := by
    rw [← betaG_eq_betaIntegral (by norm_num) (by norm_num), eq_div_iff hz, perA5]
    norm_num
    ring
  have hcalg : IsAlgebraic ℚ (c / (1 - zetaN 5)) := by
    rw [← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr hc)
      (sub_mem (one_mem _) (mem_algebraicClosure_iff.mpr (isAlgebraic_zetaN 5 (by norm_num))))
  have h := fourExpAt_A 5 2 (fun s => (s : ℕ) + 1) perA5 0 (by norm_num) hW (by decide) rfl (by decide)
    (wuestholzA5_of hW) (c / (1 - zetaN 5)) hcalg (div_ne_zero hc0 hz)
  rw [hB]
  convert h using 1
  field_simp

/-- **Theorem MG-A for `B(1/7, 1/7)`**: `FourExpAt (c B(1/7, 1/7)/π)` for algebraic `c ≠ 0`. -/
theorem fourExpAt_beta7 (hW : Thm11KappaA 7 3 (fun s => (s : ℕ) + 1) perT 0)
    (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * betaIntegral (1 / 7) (1 / 7) / Real.pi) := by
  have hz := one_sub_zeta7_pow_ne (j := 1) (by norm_num) (by norm_num)
  rw [pow_one] at hz
  have hB : betaIntegral (1 / 7) (1 / 7) = perT 0 / (1 - zeta7) := by
    rw [← betaG_eq_betaIntegral (by norm_num) (by norm_num), eq_div_iff hz, perT, perA]
    norm_num
    ring
  have hcalg : IsAlgebraic ℚ (c / (1 - zeta7)) := by
    rw [← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr hc)
      (sub_mem (one_mem _) (mem_algebraicClosure_iff.mpr isAlgebraic_zeta7))
  have h := fourExpAt_A 7 3 (fun s => (s : ℕ) + 1) perT 0 (by norm_num) hW (by decide) rfl (by decide)
    (wuestholzA7_of hW) (c / (1 - zeta7)) hcalg (div_ne_zero hc0 hz)
  rw [hB]
  convert h using 1
  field_simp

/-- **`2^t` and `3^t` are not both algebraic at `t = Γ(1/5)²/(πΓ(2/5)) = B(1/5, 1/5)/π`.** -/
theorem two_three_beta5 (hW : Thm11KappaA 5 2 (fun s => (s : ℕ) + 1) perA5 0) :
    ¬ (IsAlgebraic ℚ (Complex.exp (betaIntegral (1 / 5) (1 / 5) / Real.pi * Complex.log 2)) ∧
        IsAlgebraic ℚ (Complex.exp (betaIntegral (1 / 5) (1 / 5) / Real.pi * Complex.log 3))) := by
  have h := fourExpAt_beta5 hW 1 isAlgebraic_one one_ne_zero (Complex.log 2) (Complex.log 3)
    (by simpa using log_mem_logAlg 2 two_ne_zero) (by simpa using log_mem_logAlg 3 three_ne_zero)
    linearIndependent_two_three
  simpa using h

/-- **Theorem MG-A, inverted family**: `FourExpAt (cπ/B(1/5, 1/5))`. -/
theorem fourExpAt_pi_div_beta5 (hW : Thm11KappaA 5 2 (fun s => (s : ℕ) + 1) perA5 0)
    (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * Real.pi / betaIntegral (1 / 5) (1 / 5)) := by
  have h := fourExpAt_beta5 hW c⁻¹ hc.inv (inv_ne_zero hc0)
  have hB : betaIntegral (1 / 5) (1 / 5) ≠ 0 := by
    rw [← betaG_eq_betaIntegral (by norm_num) (by norm_num), betaG]
    exact div_ne_zero (mul_ne_zero (Gamma_ne_zero_of_re_pos (by norm_num)) (Gamma_ne_zero_of_re_pos (by norm_num)))
      (Gamma_ne_zero_of_re_pos (by norm_num))
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have := fourExpAt_inv h (div_ne_zero (mul_ne_zero (inv_ne_zero hc0) hB) hpi)
  convert this using 1
  field_simp

end CM4E.AbVar
