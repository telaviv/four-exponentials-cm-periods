import Mathlib
import CM4E.AbVar.ThmA

/-!
# Theorem MG♮-A: four exponentials at `cP` and `c/P` (paper [II], `thm:MGnA`)

Second-kind slot. With `A`, `ζ = ζ_N`, `κ`, `P`, `γ` as in `CM4E/AbVar/ThmA.lean`, let `σ̄` be the embedding `ζ ↦ ζ^{N−1}`
(complex conjugate of the identity embedding), `w` the corresponding fibre coordinate on `Lie(A^♮)`, and `P̄ = w(γ̃)` the
second-kind period of the lift `γ̃` of `γ`; `w([ζ^e]X) = ζ^{(N−1)e} w(X)`. For an `F`-basis `b` of `K` the group is
`G'' = G_m^{2n} × Q''`, `Q'' = (A^♮)^r / W'` with `W' = {fibre vectors with Σ_j b_j w_j = 0}` (`w_j` the `σ̄`-coordinate of
copy `j`; `W'` contains the other fibre directions): an extension of `A^r` by
`G_a`, with tangent coordinates `(q(s, j), f)`, `f = Σ_j b_j w_j`, and linear form `λ = f` (frame `gmF`). Its periods are
generated by the images of `[ζ^e]γ̃` in copy `j`: base `ζ^{κ s · e} P s`, fibre `b_j ζ^{(N−1)e} P̄`.

`fourExpAt_An`: `FourExpAt (cP̄/π)` for algebraic `c ≠ 0`, assuming W88 §5d for these groups and `P̄/π ∉ ℚ̄` (the
latter follows from the former: `transcendental_div_pi_of_thm11KappaAn`). When
`P P̄ ∈ πℚ̄ˣ` (Legendre-type relation; proved below for `y⁵ = x(1 − x)` from Euler's reflection formula), this is
`FourExpAt (c/P)`, hence `FourExpAt (cP)` (`fourExpAt_inv`).

Notation: Lean's `σ̄`, `P̄` are the paper's second-kind `σ`, `P_σ`; Lean's first-kind `P` is the paper's `P_{σ̄}`.
The generic hypothesis is a W88 instance only for genuine parameters (`φ(N) = 2g`, `ζ ↦ ζ^{N−1}` a second-kind slot).

Soundness of `gmAn` (not checked by Lean; per instance): `Q''` is an algebraic group over `ℚ̄`; `P̄` is the period of the
second-kind eigen-differential over `γ`; `G_m^{2n} × Q''` has connected subgroups `T_L × H`; a nonzero connected `H ⊂ Q''`
contains the fibre `G_a` (a splitting over a nonzero abelian subvariety `B_S` would need `f = 0` on the fibre `W_{B_S}` of
`B_S^♮`, i.e. `Σ_j b_j σ̄(m_j) = 0` on `S`, forcing `S = 0`), so `λ ≠ 0` on `T(H)`; `d₂ = gr + 1 < φ(N) r`.

Instance: `y⁵ = x(1 − x)`, `P̄ = (1 − ζ₅⁴) B(4/5, 4/5)` (the period of `dx/y` over `γ`), and
`B(1/5, 1/5) B(4/5, 4/5) ∈ πℚ̄ˣ`: **`2^t, 3^t` are not both algebraic at `t = B(1/5, 1/5) = Γ(1/5)²/Γ(2/5)`**
(`two_three_beta5'`), the example of paper [II], Theorem A.
-/

open Complex Module CM4E.Waldschmidt CM4E.Gen

namespace CM4E.AbVar

variable (N g : ℕ) (κ : Fin g → ℕ) (P : Fin g → ℂ) (Pb : ℂ) {r : ℕ} (b : Fin r → ℂ)

/-- Generators of the periods of `Q''`: the images of `[ζ^e]γ̃` in copy `j`. -/
noncomputable def perAngen : Set ((Fin g × Fin r → ℂ) × ℂ) :=
  Set.range (fun je : Fin r × ℕ =>
    ((fun p => if p.2 = je.1 then zetaN N ^ (κ p.1 * je.2) * P p.1 else 0),
      b je.1 * zetaN N ^ ((N - 1) * je.2) * Pb))

/-- The `ℚ̄`-structure of `T(Q'')`. -/
def algAn (q : (Fin g × Fin r → ℂ) × ℂ) : Prop := (∀ p, IsAlgebraic ℚ (q.1 p)) ∧ IsAlgebraic ℚ q.2

/-- **The model of `G_m^{2n} × Q''`.** -/
noncomputable def gmAn : GroupModel (TF (Fin r × Fin N.totient) ((Fin g × Fin r → ℂ) × ℂ)) :=
  gmF (algAn g) (perAngen N g κ P Pb b) (LinearMap.snd ℂ _ ℂ)

/-- **The hypothesis for Theorem MG♮-A**: W88 §5d for `G_m^{2n} × Q''`, for every `F`-basis `b` of a number field. -/
def Thm11KappaAn : Prop :=
  ∀ (r : ℕ) (b : Fin r → ℂ), IsAdaptedBasisD (zetaN N) N.totient b → HyperplaneKappa (gmAn N g κ P Pb b)

lemma zetaN_pow_sq (hN : 2 ≤ N) (e : ℕ) : zetaN N ^ ((N - 1) * ((N - 1) * e)) = zetaN N ^ e := by
  have h1 : (N - 1) * ((N - 1) * e) = N * ((N - 2) * e) + e := by
    obtain ⟨M, rfl⟩ : ∃ M, N = M + 2 := ⟨N - 2, by omega⟩
    rw [show M + 2 - 1 = M + 1 by omega, show M + 2 - 2 = M by omega]; ring
  rw [h1, pow_add, pow_mul, (zetaN_prim N (by omega)).pow_eq_one, one_pow, one_mul]

/-- **Theorem MG♮-A (second-kind slot)**: `FourExpAt (cP̄/π)` for every algebraic `c ≠ 0`. Hypotheses: W88 §5d for the
groups `G_m^{2n} × Q''` (`hW`), `g r + 1 < φ(N) r` for all `r ≥ 1` (here: `2 ≤ g`, `2g ≤ φ(N)`), and `P̄/π ∉ ℚ̄`. -/
theorem fourExpAt_An (hN : 2 ≤ N) (hW : Thm11KappaAn N g κ P Pb) (hg2 : 2 ≤ g) (hg : 2 * g ≤ N.totient)
    (hT : Transcendental ℚ (Pb / Real.pi)) (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * Pb / Real.pi) := by
  intro x₁ x₂ hx₁ hx₂ hind ⟨ht₁, ht₂⟩
  obtain ⟨r, hr, b, hb, hS⟩ := exists_adapted_basisN N (by omega) {c, I}
    (by intro s hs; simp at hs; rcases hs with rfl | rfl; exacts [hc, isAlgebraic_I])
  have hcK : c ∈ KspanD (zetaN N) N.totient b := hS c (by simp)
  have hIK : I ∈ KspanD (zetaN N) N.totient b := hS I (by simp)
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hθalg := thetaD_isAlgebraic (isAlgebraic_zetaN N (by omega)) N.totient hb.alg
  -- the period lifts
  have h2 : (2 : ℂ) ∈ KspanD (zetaN N) N.totient b := by
    have := Submodule.smul_mem _ (2 : ℚ) hb.one_mem
    simpa [Rat.smul_def] using this
  have hxK : ∀ h, 2 * I * c * thetaD (zetaN N) N.totient b h ∈ KspanD (zetaN N) N.totient b := fun h =>
    hb.mul_mem _ (hb.mul_mem _ (hb.mul_mem _ h2 _ hIK) _ hcK) _ (Submodule.subset_span ⟨h, rfl⟩)
  let pv : Fin r × Fin N.totient → (Fin g × Fin r → ℂ) × ℂ := fun p =>
    ((fun p' => if p'.2 = p.1 then zetaN N ^ (κ p'.1 * ((N - 1) * (p.2 : ℕ))) * P p'.1 else 0),
      b p.1 * zetaN N ^ ((N - 1) * ((N - 1) * (p.2 : ℕ))) * Pb)
  have hpv : ∀ p, (pv p).2 = thetaD (zetaN N) N.totient b p * Pb := by
    intro p
    simp only [pv, thetaD, zetaN_pow_sq N hN]; ring
  let qh : Fin r × Fin N.totient → (Fin g × Fin r → ℂ) × ℂ := fun h =>
    ∑ p, (coordsD (zetaN N) N.totient b (2 * I * c * thetaD (zetaN N) N.totient b h) p : ℚ) • pv p
  have hqh : ∀ h, qh h ∈ Submodule.span ℚ (perAngen N g κ P Pb b) := fun h =>
    Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨(p.1, (N - 1) * p.2), rfl⟩)
  have hlqh : ∀ h, LinearMap.snd ℂ _ ℂ (qh h) =
      c * Pb / Real.pi * (2 * Real.pi * I * thetaD (zetaN N) N.totient b h) := by
    intro h
    simp only [qh, LinearMap.snd_apply, Prod.snd_sum, Prod.smul_snd, hpv, Rat.smul_def]
    rw [show ∑ p, (coordsD (zetaN N) N.totient b (2 * I * c * thetaD (zetaN N) N.totient b h) p : ℂ) *
        (thetaD (zetaN N) N.totient b p * Pb) =
        (∑ p, (coordsD (zetaN N) N.totient b (2 * I * c * thetaD (zetaN N) N.totient b h) p : ℂ) *
          thetaD (zetaN N) N.totient b p) * Pb by
      rw [Finset.sum_mul]; congr 1; funext p; ring, coordsD_spec (hxK h)]
    field_simp
  -- `s = cP̄/π` is transcendental
  have hs : Transcendental ℚ (c * Pb / Real.pi) := by
    intro halg
    apply hT
    have : Pb / Real.pi = (c * Pb / Real.pi) / c := by field_simp
    rw [this, ← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr halg) (mem_algebraicClosure_iff.mpr hc)
  have hs0 : c * Pb / Real.pi ≠ 0 := fun h => hs (h ▸ isAlgebraic_zero)
  have hindY : LinearIndependent ℚ ![c * Pb / Real.pi * x₁, c * Pb / Real.pi * x₂] := by
    rw [Fintype.linearIndependent_iff] at hind ⊢
    intro g' hg'
    refine hind g' ?_
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Rat.smul_def] at hg' ⊢
    have : (c * Pb / Real.pi) * ((g' 0 : ℂ) * x₁ + (g' 1 : ℂ) * x₂) = 0 := by linear_combination hg'
    exact (mul_eq_zero.mp this).resolve_left hs0
  have hfin : finrank ℂ ((Fin g × Fin r → ℂ) × ℂ) < Fintype.card (Fin r × Fin N.totient) := by
    simp only [Module.finrank_prod, Module.finrank_fintype_fun_eq_card, Fintype.card_prod, Fintype.card_fin,
      Module.finrank_self]
    nlinarith
  refine frame_false (thetaD (zetaN N) N.totient b) hb.indep hθalg (algAn g) (perAngen N g κ P Pb b)
    (LinearMap.snd ℂ _ ℂ) (hW r b hb) hfin ⟨fun _ => isAlgebraic_zero, isAlgebraic_zero⟩
    (fun c' q hc' hq => ⟨fun p => by simpa using hc'.mul (hq.1 p), by simpa using hc'.mul hq.2⟩)
    (0, 1) ⟨fun _ => isAlgebraic_zero, isAlgebraic_one⟩ rfl
    (Set.range fun p => ((Pi.single p 1 : Fin g × Fin r → ℂ), (0 : ℂ)))
    ?_ ?_ _ hs qh hqh hlqh x₁ (c * Pb / Real.pi * x₁) x₂ (c * Pb / Real.pi * x₂) hx₁ ht₁ hx₂ ht₂
    rfl rfl hindY
  · rintro _ ⟨p, rfl⟩
    refine ⟨fun k => ?_, isAlgebraic_zero⟩
    simp only [Pi.single_apply]; split_ifs
    exacts [isAlgebraic_one, isAlgebraic_zero]
  · apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨p, rfl⟩
      simp
    · rintro ⟨q, f⟩ hqf
      simp only [LinearMap.mem_ker, LinearMap.snd_apply] at hqf
      subst hqf
      have : ((q, (0 : ℂ)) : (Fin g × Fin r → ℂ) × ℂ) = ∑ p, q p • ((Pi.single p 1 : Fin g × Fin r → ℂ), (0 : ℂ)) := by
        refine Prod.ext ?_ (by simp [Prod.snd_sum])
        simp only [Prod.fst_sum, Prod.smul_fst]
        exact (sum_smul_single q).symm
      rw [this]
      exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨p, rfl⟩)

/-- **`P̄/π ∉ ℚ̄` from the hypothesis of Theorem MG♮-A** (lean_lsg ABVAR.md §1.6, with the fibre coordinate `f` in place
of `λ`). If `P̄ = απ` with `α ∈ ℚ̄`, the hyperplane `V = W = ker (f − aθᵀx − aμθᵀy)` (`a = α/(2i)`, `μ ∈ ℚ̄ ∖ K`)
contains the period lift `(2πi e_{(0,0)}, 0; [ζ⁰]γ̃)` (fibre `b_0 P̄`), and `(5.4)` holds with `m = 1`; but `V` contains
no `T_L × H ≠ 0` (`Gen.frameW_false`). -/
theorem transcendental_div_pi_of_thm11KappaAn (hN : 2 ≤ N) (hW : Thm11KappaAn N g κ P Pb) (hPb : Pb ≠ 0) :
    Transcendental ℚ (Pb / Real.pi) := by
  intro hα
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  obtain ⟨r, hr, b, hb, -⟩ := exists_adapted_basisN N (by omega) ∅ (by simp)
  obtain ⟨μ, hμalg, hμK⟩ := exists_not_mem_KspanD hb
  have ht0 : 0 < N.totient := Nat.totient_pos.mpr (by omega)
  set j0 : Fin r := ⟨0, by omega⟩
  refine frameW_false (thetaD (zetaN N) N.totient b) hb.indep
    (thetaD_isAlgebraic (isAlgebraic_zetaN N (by omega)) N.totient hb.alg) (algAn g) (perAngen N g κ P Pb b)
    (LinearMap.snd ℂ _ ℂ) (good := fun _ => True) (hW r b hb).on (fun q hq => hq.2) ⟨fun _ => isAlgebraic_zero, isAlgebraic_zero⟩
    (Set.range (fun p => ((Pi.single p 1 : Fin g × Fin r → ℂ), (0 : ℂ))) ∪ {((0 : Fin g × Fin r → ℂ), (1 : ℂ))})
    ?_ ?_ μ hμalg (adapted_mu_indep hb hμK) (Pb / Real.pi) hα (div_ne_zero hPb hpi) trivial
    (j0, ⟨0, ht0⟩)
    ((fun p => if p.2 = j0 then zetaN N ^ (κ p.1 * 0) * P p.1 else 0), b j0 * zetaN N ^ ((N - 1) * 0) * Pb)
    ⟨(j0, 0), rfl⟩ ?_
  · rw [eq_top_iff]
    rintro ⟨q, f⟩ -
    have : ((q, f) : (Fin g × Fin r → ℂ) × ℂ) =
        ∑ p, q p • ((Pi.single p 1 : Fin g × Fin r → ℂ), (0 : ℂ)) + f • ((0 : Fin g × Fin r → ℂ), (1 : ℂ)) := by
      refine Prod.ext ?_ (by simp [Prod.snd_sum])
      simp only [Prod.fst_add, Prod.fst_sum, Prod.smul_mk, smul_zero, add_zero]
      exact (sum_smul_single q).symm
    rw [this]
    exact add_mem (Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨p, rfl⟩)))
      (Submodule.smul_mem _ _ (Submodule.subset_span (Or.inr rfl)))
  · rintro _ (⟨p, rfl⟩ | h)
    · exact ⟨fun k => isAlgebraic_single p k, isAlgebraic_zero⟩
    · rw [Set.mem_singleton_iff] at h
      subst h
      exact ⟨fun _ => isAlgebraic_zero, isAlgebraic_one⟩
  · simp [thetaD]

/-! ## Instance: `y⁵ = x(1 − x)`, second kind -/

/-- `sin(πk/N)` is algebraic. -/
lemma isAlgebraic_sin_pi_div (k N : ℕ) (hN : N ≠ 0) :
    IsAlgebraic ℚ (Complex.sin (Real.pi * ((k : ℂ) / N))) := by
  set u := Complex.exp (Real.pi * I / N)
  set v := Complex.exp (-(Real.pi * I / N))
  have hroot : ∀ w : ℂ, w ^ (2 * N) = 1 → IsAlgebraic ℚ w := fun w hw =>
    ⟨Polynomial.X ^ (2 * N) - Polynomial.C 1, Polynomial.X_pow_sub_C_ne_zero (by omega) 1, by simp [hw]⟩
  have hu : IsAlgebraic ℚ u := hroot u (by
    rw [← Complex.exp_nat_mul]; push_cast
    rw [show (2 * (N : ℂ)) * (Real.pi * I / N) = 2 * Real.pi * I by field_simp]
    exact Complex.exp_two_pi_mul_I)
  have hv : IsAlgebraic ℚ v := hroot v (by
    rw [← Complex.exp_nat_mul]; push_cast
    rw [show (2 * (N : ℂ)) * -(Real.pi * I / N) = -(2 * Real.pi * I) by field_simp]
    rw [Complex.exp_neg, Complex.exp_two_pi_mul_I, inv_one])
  have e1 : Complex.exp (-(Real.pi * ((k : ℂ) / N)) * I) = v ^ k := by
    rw [← Complex.exp_nat_mul]; congr 1; ring
  have e2 : Complex.exp (Real.pi * ((k : ℂ) / N) * I) = u ^ k := by
    rw [← Complex.exp_nat_mul]; congr 1; ring
  rw [Complex.sin, e1, e2, ← mem_algebraicClosure_iff]
  exact div_mem (mul_mem (sub_mem (pow_mem (mem_algebraicClosure_iff.mpr hv) k)
    (pow_mem (mem_algebraicClosure_iff.mpr hu) k)) (mem_algebraicClosure_iff.mpr isAlgebraic_I)) (by simp)

/-- The second-kind period `P̄ = (1 − ζ₅⁴) B(4/5, 4/5)` (`∫_γ dx/y`). -/
noncomputable def perB5 : ℂ := (1 - zetaN 5 ^ 4) * betaG (4 / 5) (4 / 5)

/-- `P̄/π ∉ ℚ̄` for the second-kind period `P̄` (Wüstholz 1989; paper [II], (W)). Formerly a named input; now a
corollary of the hypothesis of Theorem MG♮-A (`wuestholzB5_of`). -/
def WuestholzB5 : Prop := Transcendental ℚ (perB5 / Real.pi)

lemma perB5_ne_zero : perB5 ≠ 0 := by
  have hz4 : 1 - zetaN 5 ^ 4 ≠ 0 := by
    intro h
    exact (zetaN_prim 5 (by norm_num)).pow_ne_one_of_pos_of_lt (l := 4) (by norm_num) (by norm_num)
      (by linear_combination -h)
  exact mul_ne_zero hz4 (div_ne_zero (mul_ne_zero (Gamma_ne_zero_of_re_pos (by norm_num))
    (Gamma_ne_zero_of_re_pos (by norm_num))) (Gamma_ne_zero_of_re_pos (by norm_num)))

/-- **`WuestholzB5` is a corollary of the hypothesis of Theorem MG♮-A** at `y⁵ = x(1 − x)`. -/
theorem wuestholzB5_of (hW : Thm11KappaAn 5 2 (fun s => (s : ℕ) + 1) perA5 perB5) : WuestholzB5 :=
  transcendental_div_pi_of_thm11KappaAn 5 2 (fun s => (s : ℕ) + 1) perA5 perB5 (by norm_num) hW perB5_ne_zero

/-- The constant `ρ = (5/3) sin(2π/5)/sin(π/5)²` with `B(1/5, 1/5) B(4/5, 4/5) = ρπ`. -/
noncomputable def rho5 : ℂ :=
  5 / 3 * Complex.sin (Real.pi * ((2 : ℕ) / (5 : ℕ))) / Complex.sin (Real.pi * ((1 : ℕ) / (5 : ℕ))) ^ 2

lemma isAlgebraic_rho5 : IsAlgebraic ℚ rho5 := by
  rw [rho5, ← mem_algebraicClosure_iff]
  have h53 : (5 / 3 : ℂ) ∈ algebraicClosure ℚ ℂ := by
    simpa using (algebraicClosure ℚ ℂ).algebraMap_mem (5 / 3 : ℚ)
  exact div_mem (mul_mem h53 (mem_algebraicClosure_iff.mpr (isAlgebraic_sin_pi_div 2 5 (by norm_num))))
    (pow_mem (mem_algebraicClosure_iff.mpr (isAlgebraic_sin_pi_div 1 5 (by norm_num))) 2)

/-- **`B(1/5, 1/5) B(4/5, 4/5) = ρπ`** (Euler's reflection formula and `Γ(8/5) = (3/5)Γ(3/5)`). -/
lemma beta5_mul : betaG (1 / 5) (1 / 5) * betaG (4 / 5) (4 / 5) = rho5 * Real.pi := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have r1 := Complex.Gamma_mul_Gamma_one_sub (1 / 5)
  have r2 := Complex.Gamma_mul_Gamma_one_sub (2 / 5)
  have g8 : Gamma (8 / 5) = 3 / 5 * Gamma (3 / 5) := by
    rw [show (8 / 5 : ℂ) = 3 / 5 + 1 by norm_num, Complex.Gamma_add_one _ (by norm_num)]
  have hs1 : Complex.sin (Real.pi * (1 / 5)) ≠ 0 := by
    rw [show (Real.pi : ℂ) * (1 / 5) = ((Real.pi * (1 / 5) : ℝ) : ℂ) by push_cast; ring, ← Complex.ofReal_sin]
    exact Complex.ofReal_ne_zero.mpr (Real.sin_pos_of_pos_of_lt_pi (by positivity) (by linarith [Real.pi_pos])).ne'
  have hs2 : Complex.sin (Real.pi * (2 / 5)) ≠ 0 := by
    rw [show (Real.pi : ℂ) * (2 / 5) = ((Real.pi * (2 / 5) : ℝ) : ℂ) by push_cast; ring, ← Complex.ofReal_sin]
    exact Complex.ofReal_ne_zero.mpr (Real.sin_pos_of_pos_of_lt_pi (by positivity) (by linarith [Real.pi_pos])).ne'
  have g2 : Gamma (2 / 5) ≠ 0 := Gamma_ne_zero_of_re_pos (by norm_num)
  have g3 : Gamma (3 / 5) ≠ 0 := Gamma_ne_zero_of_re_pos (by norm_num)
  norm_num at r1 r2
  simp only [betaG, rho5]
  norm_num
  rw [g8]
  have e : Gamma (1 / 5) * Gamma (1 / 5) / Gamma (2 / 5) * (Gamma (4 / 5) * Gamma (4 / 5) / (3 / 5 * Gamma (3 / 5)))
      = 5 / 3 * (Gamma (5⁻¹) * Gamma (4 / 5)) ^ 2 / (Gamma (2 / 5) * Gamma (3 / 5)) := by
    norm_num; field_simp
  norm_num at e ⊢
  rw [e, r1, r2]
  field_simp

/-- **Theorem MG♮-A for `B(1/5, 1/5)`**: `FourExpAt (c B(1/5, 1/5))` for algebraic `c ≠ 0`. -/
theorem fourExpAt_beta5' (hW : Thm11KappaAn 5 2 (fun s => (s : ℕ) + 1) perA5 perB5)
    (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) : FourExpAt (c * betaIntegral (1 / 5) (1 / 5)) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hz4 : 1 - zetaN 5 ^ 4 ≠ 0 := by
    intro h
    exact (zetaN_prim 5 (by norm_num)).pow_ne_one_of_pos_of_lt (l := 4) (by norm_num) (by norm_num)
      (by linear_combination -h)
  have hB1 : betaG (1 / 5) (1 / 5) ≠ 0 :=
    div_ne_zero (mul_ne_zero (Gamma_ne_zero_of_re_pos (by norm_num)) (Gamma_ne_zero_of_re_pos (by norm_num)))
      (Gamma_ne_zero_of_re_pos (by norm_num))
  have hB4 : betaG (4 / 5) (4 / 5) ≠ 0 :=
    div_ne_zero (mul_ne_zero (Gamma_ne_zero_of_re_pos (by norm_num)) (Gamma_ne_zero_of_re_pos (by norm_num)))
      (Gamma_ne_zero_of_re_pos (by norm_num))
  have hm := beta5_mul
  have hρ0 : rho5 ≠ 0 := by
    intro h; rw [h, zero_mul] at hm
    exact mul_ne_zero hB1 hB4 hm
  set c' := (c * (1 - zetaN 5 ^ 4) * rho5)⁻¹ with hc'
  have hc'alg : IsAlgebraic ℚ c' := by
    rw [hc', ← mem_algebraicClosure_iff]
    exact inv_mem (mul_mem (mul_mem (mem_algebraicClosure_iff.mpr hc) (sub_mem (one_mem _)
      (pow_mem (mem_algebraicClosure_iff.mpr (isAlgebraic_zetaN 5 (by norm_num))) 4)))
      (mem_algebraicClosure_iff.mpr isAlgebraic_rho5))
  have hc'0 : c' ≠ 0 := inv_ne_zero (mul_ne_zero (mul_ne_zero hc0 hz4) hρ0)
  have h := fourExpAt_An 5 2 (fun s => (s : ℕ) + 1) perA5 perB5 (by norm_num) hW le_rfl (by decide) (wuestholzB5_of hW) c'
    hc'alg hc'0
  have ht0 : c' * perB5 / Real.pi ≠ 0 := by
    rw [perB5]; exact div_ne_zero (mul_ne_zero hc'0 (mul_ne_zero hz4 hB4)) hpi
  have hinv := fourExpAt_inv h ht0
  rw [← betaG_eq_betaIntegral (by norm_num) (by norm_num)]
  convert hinv using 1
  rw [hc', perB5]
  have hB4' : betaG (4 / 5) (4 / 5) = rho5 * Real.pi / betaG (1 / 5) (1 / 5) := by
    rw [eq_div_iff hB1]; linear_combination hm
  rw [hB4']
  field_simp

/-- **`2^t` and `3^t` are not both algebraic at `t = B(1/5, 1/5) = Γ(1/5)²/Γ(2/5)`** (paper [II], Theorem A). -/
theorem two_three_beta5' (hW : Thm11KappaAn 5 2 (fun s => (s : ℕ) + 1) perA5 perB5) :
    ¬ (IsAlgebraic ℚ (Complex.exp (betaIntegral (1 / 5) (1 / 5) * Complex.log 2)) ∧
        IsAlgebraic ℚ (Complex.exp (betaIntegral (1 / 5) (1 / 5) * Complex.log 3))) := by
  have h := fourExpAt_beta5' hW 1 isAlgebraic_one one_ne_zero (Complex.log 2) (Complex.log 3)
    (by simpa using log_mem_logAlg 2 two_ne_zero) (by simpa using log_mem_logAlg 3 three_ne_zero)
    linearIndependent_two_three
  simpa using h

