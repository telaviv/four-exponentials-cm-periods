import Mathlib
import CM4E.Waldschmidt
import LSG.W88.Statement

/-!
# The standard model of `G_a^{d₀} × G_m^{d₁} × E₁ × ⋯ × E_m`

`gmStd d₀ d₁ Ls` is the group model, in the coordinates of `lean_lsg` (`LSG/W88/Statement.lean`), of
`G_a^{d₀} × G_m^{d₁} × E₁ × ⋯ × E_m`: `d₁ = d₁`, `d₂ = m` (the `G_a` factor is `d₀` and does not enter (5.4)), algebraic
vectors, logarithms `Lam Ls`, periods the `ℚ`-span of `Per Ls`, and the connected algebraic subgroups `SubgroupData`.
`HypStd` is W88 §5d for all these groups; it is to be supplied by `lean_lsg` (the §5d deduction from its proved
Theorem 4.1, `LSG.W88.theorem41Abelian`). The bridges of `CM4E/Bridge/` reduce the hypotheses of `CM4E/Gen/` to it.
-/

open Module CM4E.Waldschmidt LSG.W88

namespace CM4E.Bridge

variable {d0 d1 m : ℕ}

/-- Algebraic vectors of `Tan d₀ d₁ m`. -/
def algStd (v : Tan d0 d1 m) : Prop := AlgVec v.1 ∧ AlgVec v.2.1 ∧ AlgVec v.2.2

/-- **The standard model of `G_a^{d₀} × G_m^{d₁} × E₁ × ⋯ × E_m`.** -/
noncomputable def gmStd (d0 d1 : ℕ) {m : ℕ} (Ls : Fin m → PeriodPair) : GroupModel (Tan d0 d1 m) where
  d₁ := d1
  d₂ := m
  alg := algStd
  lam := Lam Ls
  per := Submodule.span ℚ (Per (d0 := d0) (d1 := d1) Ls : Set (Tan d0 d1 m))
  sub := fun S => ∃ H : SubgroupData (d0 := d0) (d1 := d1) Ls, S = H.tan

/-- **W88 §5d for `G_a^{d₀} × G_m^{d₁} × E₁ × ⋯ × E_m`** (curves with algebraic invariants). -/
def HypStd : Prop :=
  ∀ (d0 d1 m : ℕ) (Ls : Fin m → PeriodPair), (∀ j, IsAlgebraic ℚ (Ls j).g₂ ∧ IsAlgebraic ℚ (Ls j).g₃) →
    HyperplaneKappa (gmStd d0 d1 Ls)

/-- **W88 §5d for `G_a^{d₀} × G_m^{d₁} × E^r`, one curve `E` repeated** (to be supplied by `lean_lsg`, as a consequence of
its `HypStd`). -/
def HypStdCM (L : PeriodPair) : Prop :=
  ∀ (d0 d1 r : ℕ), IsAlgebraic ℚ L.g₂ → IsAlgebraic ℚ L.g₃ → HyperplaneKappa (gmStd d0 d1 (fun _ : Fin r => L))

lemma hypStdCM_of_hypStd (h : HypStd) (L : PeriodPair) : HypStdCM L :=
  fun d0 d1 r h₂ h₃ => h d0 d1 r _ (fun _ => ⟨h₂, h₃⟩)

/-- The case `d₀ = d` of `HypStdCM` (the bridges use `d = 0` for Theorem MG and `d = 2` for Theorem SMG; for `d₀ = 0` every
configuration outside (NR) is trivial, while `d₀ > 0` also needs Roy's (NR)-free linear case). -/
def HypStdCMAt (L : PeriodPair) (d : ℕ) : Prop :=
  ∀ (d1 r : ℕ), IsAlgebraic ℚ L.g₂ → IsAlgebraic ℚ L.g₃ → HyperplaneKappa (gmStd d d1 (fun _ : Fin r => L))

lemma hypStdCMAt_of_hypStdCM {L : PeriodPair} (h : HypStdCM L) (d : ℕ) : HypStdCMAt L d :=
  fun d1 r h₂ h₃ => h d d1 r h₂ h₃

/-- The logarithms with every `E`-coordinate a period: an additive subgroup of `Lam Ls`. -/
def lamPer (Ls : Fin m → PeriodPair) : AddSubgroup (Tan d0 d1 m) where
  carrier := {p | AlgVec p.1 ∧ (∀ i, IsAlgebraic ℚ (Complex.exp (p.2.1 i))) ∧ ∀ j, p.2.2 j ∈ (Ls j).lattice}
  add_mem' {p q} hp hq := by
    refine ⟨fun i => (hp.1 i).add (hq.1 i), fun i => ?_, fun j => (Ls j).lattice.add_mem (hp.2.2 j) (hq.2.2 j)⟩
    show IsAlgebraic ℚ (Complex.exp (p.2.1 i + q.2.1 i))
    rw [Complex.exp_add]; exact (hp.2.1 i).mul (hq.2.1 i)
  zero_mem' := ⟨fun _ => isAlgebraic_zero, fun _ => by simpa using isAlgebraic_one, fun j => (Ls j).lattice.zero_mem⟩
  neg_mem' {p} hp := by
    refine ⟨fun i => (hp.1 i).neg, fun i => ?_, fun j => (Ls j).lattice.neg_mem (hp.2.2 j)⟩
    show IsAlgebraic ℚ (Complex.exp (-p.2.1 i))
    rw [Complex.exp_neg]; exact (hp.2.1 i).inv

lemma lamPer_le_Lam (Ls : Fin m → PeriodPair) : ((lamPer (d0 := d0) (d1 := d1) Ls : Set (Tan d0 d1 m))) ⊆ Lam Ls :=
  fun _ hp => ⟨hp.1, hp.2.1, fun j => Or.inl (hp.2.2 j)⟩

/-- A positive integer multiple of an element of the `ℚ`-span of `S` lies in the additive subgroup generated by `S`. -/
lemma exists_nsmul_mem_closure {E : Type*} [AddCommGroup E] [Module ℚ E] (S : Set E) {v : E}
    (hv : v ∈ Submodule.span ℚ S) : ∃ D : ℕ, 0 < D ∧ D • v ∈ AddSubgroup.closure S := by
  induction hv using Submodule.span_induction with
  | mem x hx => exact ⟨1, one_pos, by simpa using AddSubgroup.subset_closure hx⟩
  | zero => exact ⟨1, one_pos, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨D₁, h₁, hx⟩ := hx
    obtain ⟨D₂, h₂, hy⟩ := hy
    refine ⟨D₁ * D₂, Nat.mul_pos h₁ h₂, ?_⟩
    rw [smul_add, mul_comm D₁ D₂, mul_smul, mul_comm D₂ D₁, mul_smul]
    exact add_mem (AddSubgroup.nsmul_mem _ hx _) (AddSubgroup.nsmul_mem _ hy _)
  | smul q x _ hx =>
    obtain ⟨D, hD, hx⟩ := hx
    refine ⟨q.den * D, Nat.mul_pos q.den_pos hD, ?_⟩
    have : (q.den * D) • (q • x) = q.num • (D • x) := by
      rw [← Nat.cast_smul_eq_nsmul ℚ, ← Nat.cast_smul_eq_nsmul ℚ D, ← Int.cast_smul_eq_zsmul ℚ, smul_smul,
        smul_smul]
      congr 1
      push_cast
      rw [mul_comm (q.den : ℚ) (D : ℚ), mul_assoc, Rat.den_mul_eq_num]
      ring
    rw [this]
    exact AddSubgroup.zsmul_mem _ hx _

end CM4E.Bridge
