import Mathlib
import CM4E.Gen.MGn

/-!
# Theorem MG / Cor. MG2 for every algebraic `c`: four exponentials at `t = cω/π`

For a CM lattice `L = ω ℤ[α]` and an adapted basis `θ` of `K ⊇ ℚ(α)`, the group of the paper's proof of Theorem MG is
`G'' = G_m^{2n} × A''`, `A'' = E^n / B_{ker ψ}`, `ψ(m) = Σ θ_j m_j` on `k^n`. Its tangent space is modelled as
`((ι → ℂ) × (ι → ℂ)) × Qψ`, `Qψ = ℂ^n / ℂ·ker ψ`, and the linear form of the frame is `λ([z]) = θᵀz`.

Soundness of `gmMG L b` (not checked by Lean): `Qψ` with the image of `ℚ̄^n` is `T(A'')` with its `ℚ̄`-structure; the
periods of `A''` are the images `[mω]`, generated by `[ω e_j]`, `[αω e_j]`; every nonzero abelian subvariety of `A''`
comes from a `k`-subspace `S' ⊋ ker ψ`, so `ψ ≠ 0` on it (paper, proof of Theorem MG), i.e. `λ ≠ 0` on its tangent
space; `A''` is an abelian variety, so `d₀ = 0` and `d₂ = dim A''`.
-/

open Complex Module CM4E.Waldschmidt

namespace CM4E.Gen

variable (L : CMLattice) {r : ℕ} (b : Fin r → ℂ)

/-- `ℂ · ker ψ`, `ψ(m) = Σ θ_j m_j` on `k^n`. -/
noncomputable def Wpsi : Submodule ℂ (Fin r × Fin 2 → ℂ) :=
  Submodule.span ℂ {v | (∀ j, v j ∈ kSet L.α) ∧ ∑ j, theta L.α b j * v j = 0}

/-- `T(A'') = ℂ^n / ℂ·ker ψ`. -/
abbrev Qm := (Fin r × Fin 2 → ℂ) ⧸ Wpsi L b

lemma Wpsi_le_ker : Wpsi L b ≤ LinearMap.ker (dotL (theta L.α b)) := by
  rw [Wpsi, Submodule.span_le]
  rintro v ⟨_, hv⟩
  simpa [dotL_apply] using hv

/-- `λ([z]) = θᵀz`. -/
noncomputable def lamM : Qm L b →ₗ[ℂ] ℂ := (Wpsi L b).liftQ (dotL (theta L.α b)) (Wpsi_le_ker L b)

lemma lamM_mk (v : Fin r × Fin 2 → ℂ) :
    lamM L b (Submodule.Quotient.mk v) = dotL (theta L.α b) v := rfl

/-- The `ℚ̄`-structure of `T(A'')`. -/
def algQm (x : Qm L b) : Prop :=
  ∃ v : Fin r × Fin 2 → ℂ, (∀ j, IsAlgebraic ℚ (v j)) ∧ Submodule.Quotient.mk v = x

/-- Generators of the periods of `A''`. -/
noncomputable def perQm : Set (Qm L b) :=
  Set.range (fun j => (Submodule.Quotient.mk (Pi.single j L.ω) : Qm L b)) ∪
    Set.range (fun j => (Submodule.Quotient.mk (Pi.single j (L.α * L.ω)) : Qm L b))

/-- The model of `G_m^{2n} × A''`. -/
noncomputable def gmMG : GroupModel (TF (Fin r × Fin 2) (Qm L b)) :=
  gmF (algQm L b) (perQm L b) (lamM L b)

/-- **The hypothesis for Theorem MG (general `c`)**: W88 §5d for `G_m^{2n} × A''`, for every adapted basis. -/
def Thm11KappaMG : Prop :=
  IsAlgebraic ℚ L.pp.g₂ → IsAlgebraic ℚ L.pp.g₃ →
    ∀ (r : ℕ) (b : Fin r → ℂ), IsAdaptedFieldBasis L.α b → HyperplaneKappa (gmMG L b)

lemma finrank_Wpsi_ge : r ≤ finrank ℂ (Wpsi L b) := by
  let u : Fin r → (Fin r × Fin 2 → ℂ) := fun k => Pi.single (k, 0) L.α - Pi.single (k, 1) 1
  have hu : ∀ k, u k ∈ Wpsi L b := by
    intro k
    refine Submodule.subset_span ⟨fun j => ?_, ?_⟩
    · simp only [u, Pi.sub_apply, Pi.single_apply]
      by_cases h1 : j = (k, 0)
      · subst h1; exact ⟨0, 1, by simp⟩
      · by_cases h2 : j = (k, 1)
        · subst h2; exact ⟨-1, 0, by simp⟩
        · exact ⟨0, 0, by simp [h1, h2]⟩
    · simp only [u, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
      simp [Pi.single_apply, theta]; ring
  have hli : LinearIndependent ℂ u := by
    rw [Fintype.linearIndependent_iff]
    intro g hg k
    have := congrArg (fun v => v (k, 1)) hg
    simpa [u, Finset.sum_apply, Pi.single_apply] using this
  let f : Fin r → Wpsi L b := fun k => ⟨u k, hu k⟩
  have hf : LinearIndependent ℂ f := LinearIndependent.of_comp (Wpsi L b).subtype hli
  simpa using hf.fintype_card_le_finrank

lemma finrank_Qm_lt (hr : 1 ≤ r) : finrank ℂ (Qm L b) < Fintype.card (Fin r × Fin 2) := by
  show finrank ℂ ((Fin r × Fin 2 → ℂ) ⧸ Wpsi L b) < _
  have h1 := Submodule.finrank_quotient_add_finrank (Wpsi L b)
  have h2 := finrank_Wpsi_ge L b
  simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_prod, Fintype.card_fin] at h1 ⊢
  omega

/-- **Cor. MG2 for a CM lattice and every algebraic `c ≠ 0`**: four exponentials at `t = cω/π`. Hypotheses: W88 §5d for
the groups `G_m^{2n} × A''` (`hW`), algebraic `g₂, g₃`, and the transcendence of `ω/π` (Schneider). -/
theorem fourExpAt_MG (hW : Thm11KappaMG L) (hg₂ : IsAlgebraic ℚ L.pp.g₂) (hg₃ : IsAlgebraic ℚ L.pp.g₃)
    (hT : Transcendental ℚ (L.ω / Real.pi)) (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * L.ω / Real.pi) := by
  intro x₁ x₂ hx₁ hx₂ hind ⟨ht₁, ht₂⟩
  have hI : IsAlgebraic ℚ I := isAlgebraic_iff_isIntegral.mpr (Complex.isIntegral_I ℚ)
  obtain ⟨r, hr, b, hb, hS⟩ := exists_adapted_basis L.α L.isAlgebraic_α L.him.ne' ⟨L.p, L.q, L.hquad⟩
    {c, I} (by intro s hs; simp at hs; rcases hs with rfl | rfl; exacts [hc, hI])
  have hcK : c ∈ Kspan L.α b := hS c (by simp)
  have hIK : I ∈ Kspan L.α b := hS I (by simp)
  have hω := L.ω_ne_zero
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hθalg := theta_isAlgebraic L.isAlgebraic_α hb.alg
  have hr1 : 1 ≤ r := by omega
  set i0 : Fin r × Fin 2 := (⟨0, by omega⟩, 0)
  have h0 : (theta L.α b) i0 ≠ 0 := hb.indep.ne_zero i0
  -- the period lifts
  have h2 : (2 : ℂ) ∈ Kspan L.α b := by
    have := Submodule.smul_mem _ (2 : ℚ) hb.one_mem
    simpa [Rat.smul_def] using this
  have hxK : ∀ h, 2 * I * c * (theta L.α b) h ∈ Kspan L.α b := fun h =>
    hb.mul_mem _ (hb.mul_mem _ (hb.mul_mem _ h2 _ hIK) _ hcK) _ (Submodule.subset_span ⟨h, rfl⟩)
  choose m hm using fun h => exists_coords (hxK h)
  let qh : Fin r × Fin 2 → Qm L b := fun h =>
    ∑ j, (m h j : ℚ) • (Submodule.Quotient.mk (Pi.single j L.ω) : Qm L b)
  have hqh : ∀ h, qh h ∈ Submodule.span ℚ (perQm L b) := fun h =>
    Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨j, rfl⟩))
  have hlqh : ∀ h, lamM L b (qh h) = c * L.ω / Real.pi * (2 * Real.pi * I * (theta L.α b) h) := by
    intro h
    simp only [qh, map_sum, map_rat_smul, lamM_mk, dotL_single, Rat.smul_def]
    have e : ∑ j, (m h j : ℂ) * ((theta L.α b) j * L.ω) = L.ω * (2 * I * c * (theta L.α b) h) := by
      rw [← hm h, Finset.mul_sum]; congr 1; funext j; ring
    rw [e]; field_simp
  -- `s = cω/π` is transcendental
  have hs : Transcendental ℚ (c * L.ω / Real.pi) := by
    intro halg
    apply hT
    have : L.ω / Real.pi = (c * L.ω / Real.pi) / c := by field_simp
    rw [this, ← mem_algebraicClosure_iff]
    exact div_mem (mem_algebraicClosure_iff.mpr halg) (mem_algebraicClosure_iff.mpr hc)
  have hs0 : c * L.ω / Real.pi ≠ 0 := div_ne_zero (mul_ne_zero hc0 hω) hpi
  have hindY : LinearIndependent ℚ ![c * L.ω / Real.pi * x₁, c * L.ω / Real.pi * x₂] := by
    rw [Fintype.linearIndependent_iff] at hind ⊢
    intro g hg
    refine hind g ?_
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Rat.smul_def] at hg ⊢
    have : (c * L.ω / Real.pi) * ((g 0 : ℂ) * x₁ + (g 1 : ℂ) * x₂) = 0 := by linear_combination hg
    exact (mul_eq_zero.mp this).resolve_left hs0
  refine frame_false (theta L.α b) hb.indep hθalg (algQm L b) (perQm L b) (lamM L b)
    (hW hg₂ hg₃ r b hb) (finrank_Qm_lt L b hr1)
    ⟨0, fun _ => isAlgebraic_zero, by simp⟩
    (fun c' q hc' ⟨v, hv, hvq⟩ => ⟨c' • v, fun j => hc'.mul (hv j), by simp [hvq]⟩)
    (Submodule.Quotient.mk (Pi.single i0 ((theta L.α b) i0)⁻¹))
    ⟨_, fun k => by
      simp only [Pi.single_apply]; split_ifs
      exacts [(hθalg i0).inv, isAlgebraic_zero], rfl⟩
    (by rw [lamM_mk, dotL_single]; exact mul_inv_cancel₀ h0)
    (Set.range fun j => (Submodule.Quotient.mk
      (((theta L.α b) i0) • Pi.single j 1 - ((theta L.α b) j) • Pi.single i0 1 : Fin r × Fin 2 → ℂ) : Qm L b))
    ?_ ?_ _ hs qh hqh hlqh x₁ (c * L.ω / Real.pi * x₁) x₂ (c * L.ω / Real.pi * x₂) hx₁ ht₁ hx₂ ht₂
    rfl rfl hindY
  · rintro _ ⟨j, rfl⟩
    refine ⟨_, fun k => ?_, rfl⟩
    simp only [Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
    exact ((hθalg i0).mul (isAlgebraic_ite _ isAlgebraic_one isAlgebraic_zero)).sub
      ((hθalg j).mul (isAlgebraic_ite _ isAlgebraic_one isAlgebraic_zero))
  · apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      simp [lamM_mk, map_sub, map_smul, dotL_single, mul_comm]
    · intro x hx
      obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      rw [LinearMap.mem_ker, lamM_mk] at hx
      have hdec := decomp_x h0 v hx
      rw [show (Submodule.Quotient.mk v : Qm L b) = (Wpsi L b).mkQ (∑ j, (v j / (theta L.α b) i0) •
          (((theta L.α b) i0) • Pi.single j 1 - ((theta L.α b) j) • Pi.single i0 1 :
            Fin r × Fin 2 → ℂ)) by rw [hdec]; rfl, map_sum]
      exact Submodule.sum_mem _ fun j _ => by
        rw [map_smul]; exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

end CM4E.Gen
