import Mathlib
import CM4E.Gen.Frame
import CM4E.Gen.CMLattice
import CM4E.Gen.BasisExists

/-!
# Theorem MG♮ / Cor. MG♮2 for every algebraic `c`: four exponentials at `t = cω`

For a CM lattice `L = ω ℤ[α]` and an adapted basis `θ` of a number field `K ⊇ ℚ(α)` (`n = [K : ℚ] = 2r`), the group of
the paper's proof of Theorem MG♮ is `G'' = G_m^{2n} × Q''`, `Q'' = (E^♮)^n / U` with `U = B^♮_{ker φ} + {θᵀw = 0}`.
Its tangent space is modelled as `((ι → ℂ) × (ι → ℂ)) × (Qφ × ℂ)`, where `Qφ = ℂ^n / ℂ·ker φ` (base coordinates of
`Q''`), the last coordinate is the fibre `θᵀw`, and `φ(m) = Σ θ_j m̄_j` on `k^n`, `k = ℚ(α)`. The fibre coordinate is
the linear form `λ` of the frame (`CM4E/Gen/Frame.lean`).

Soundness of `gmMGn L b` (not checked by Lean): the coordinates `([z], θᵀw)` on `T(Q'')`; the periods of `Q''` are the
images `([mω], θᵀη*(mω))` of the periods of `(E^♮)^n`, generated by `(ω e_j, η₀ e_j)` and `(αω e_j, ᾱη₀ e_j)`; every
nonzero connected subgroup `H` of `Q''` contains the fibre (paper, proof of Theorem MG♮: `H` over `B_{S'}` contains the
canonical lift `B^♮_{S'}`, on whose fibre directions `θᵀw = φ ≠ 0`, as `S' ⊋ ker φ`), so has `λ ≠ 0`; `d₂ = dim Q''`.
-/

open Complex Module CM4E.Waldschmidt

namespace CM4E.Gen

variable (L : CMLattice) {r : ℕ} (b : Fin r → ℂ)

/-- `ℚ(α)`, as a set. -/
def kSet (α : ℂ) : Set ℂ := {z | ∃ u v : ℚ, z = u + v * α}

/-- `ℂ · ker φ`, `φ(m) = Σ θ_j m̄_j` on `k^n`. -/
noncomputable def Wphi : Submodule ℂ (Fin r × Fin 2 → ℂ) :=
  Submodule.span ℂ {v | (∀ j, v j ∈ kSet L.α) ∧ ∑ j, theta L.α b j * starRingEnd ℂ (v j) = 0}

/-- `T(Q'') = ℂ^n / ℂ·ker φ × ℂ`. -/
abbrev Qn := ((Fin r × Fin 2 → ℂ) ⧸ Wphi L b) × ℂ

/-- The `ℚ̄`-structure of `T(Q'')`. -/
def algQn (x : Qn L b) : Prop :=
  (∃ v : Fin r × Fin 2 → ℂ, (∀ j, IsAlgebraic ℚ (v j)) ∧ Submodule.Quotient.mk v = x.1) ∧
    IsAlgebraic ℚ x.2

/-- Generators of the periods of `Q''`. -/
noncomputable def perQn : Set (Qn L b) :=
  Set.range (fun j => ((Submodule.Quotient.mk (Pi.single j L.ω) : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b),
      theta L.α b j * L.η₀)) ∪
    Set.range (fun j => ((Submodule.Quotient.mk (Pi.single j (L.α * L.ω)) : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b),
      theta L.α b j * (starRingEnd ℂ L.α * L.η₀)))

/-- The model of `G_m^{2n} × Q''`. -/
noncomputable def gmMGn : GroupModel (TF (Fin r × Fin 2) (Qn L b)) :=
  gmF (algQn L b) (perQn L b) (LinearMap.snd ℂ _ ℂ)

/-- **The hypothesis for Theorem MG♮ (general `c`)**: W88 §5d for `G_m^{2n} × Q''`, for every adapted basis. Same form
as all other hypotheses of the project (`HyperplaneKappa` of a group model). -/
def Thm11KappaMGn : Prop :=
  IsAlgebraic ℚ L.pp.g₂ → IsAlgebraic ℚ L.pp.g₃ →
    ∀ (r : ℕ) (b : Fin r → ℂ), IsAdaptedFieldBasis L.α b → HyperplaneKappa (gmMGn L b)

lemma sum_mul_conj_single (θ : Fin r × Fin 2 → ℂ) (i : Fin r × Fin 2) (c : ℂ) :
    ∑ j, θ j * starRingEnd ℂ ((Pi.single i c : Fin r × Fin 2 → ℂ) j) = θ i * starRingEnd ℂ c := by
  simp [Pi.single_apply, apply_ite (starRingEnd ℂ)]

lemma finrank_Wphi_ge : r ≤ finrank ℂ (Wphi L b) := by
  let u : Fin r → (Fin r × Fin 2 → ℂ) := fun k =>
    Pi.single (k, 0) (starRingEnd ℂ L.α) - Pi.single (k, 1) 1
  have hu : ∀ k, u k ∈ Wphi L b := by
    intro k
    refine Submodule.subset_span ⟨fun j => ?_, ?_⟩
    · simp only [u, Pi.sub_apply, Pi.single_apply]
      rw [L.conj_α]
      by_cases h1 : j = (k, 0)
      · subst h1; exact ⟨L.q, -1, by simp; ring⟩
      · by_cases h2 : j = (k, 1)
        · subst h2; exact ⟨-1, 0, by simp⟩
        · exact ⟨0, 0, by simp [h1, h2]⟩
    · simp only [u, Pi.sub_apply, map_sub, mul_sub, Finset.sum_sub_distrib, sum_mul_conj_single,
        Complex.conj_conj, map_one]
      simp [theta]; ring
  have hli : LinearIndependent ℂ u := by
    rw [Fintype.linearIndependent_iff]
    intro g hg k
    have := congrArg (fun v => v (k, 1)) hg
    simpa [u, Finset.sum_apply, Pi.single_apply] using this
  let f : Fin r → Wphi L b := fun k => ⟨u k, hu k⟩
  have hf : LinearIndependent ℂ f := LinearIndependent.of_comp (Wphi L b).subtype hli
  simpa using hf.fintype_card_le_finrank

lemma finrank_Qn_lt (hr : 2 ≤ r) :
    finrank ℂ (Qn L b) < Fintype.card (Fin r × Fin 2) := by
  have h1 := Submodule.finrank_quotient_add_finrank (Wphi L b)
  have h2 := finrank_Wphi_ge L b
  simp only [Module.finrank_prod, Module.finrank_self, Module.finrank_fintype_fun_eq_card,
    Fintype.card_prod, Fintype.card_fin] at h1 ⊢
  omega

/-- **Cor. MG♮2 for a CM lattice and every algebraic `c ≠ 0`**: four exponentials at `t = cω`. Hypotheses: W88 §5d
for the groups `G_m^{2n} × Q''` (`hW`), algebraic `g₂, g₃`, and the transcendence of `ω` (Schneider). -/
theorem fourExpAt_MGn (hW : Thm11KappaMGn L) (hg₂ : IsAlgebraic ℚ L.pp.g₂) (hg₃ : IsAlgebraic ℚ L.pp.g₃)
    (hT : Transcendental ℚ L.ω) (c : ℂ) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    FourExpAt (c * L.ω) := by
  intro x₁ x₂ hx₁ hx₂ hind ⟨ht₁, ht₂⟩
  obtain ⟨r, hr, b, hb, hS⟩ := exists_adapted_basis L.α L.isAlgebraic_α L.him.ne' ⟨L.p, L.q, L.hquad⟩
    {c} (by simpa using hc)
  have hcK : c ∈ Kspan L.α b := hS c (by simp)
  have hω := L.ω_ne_zero
  set θ := theta L.α b
  have hθalg := theta_isAlgebraic L.isAlgebraic_α hb.alg
  -- the period lifts
  have hxK : ∀ h, (L.α - starRingEnd ℂ L.α) * θ h * c⁻¹ ∈ Kspan L.α b := fun h =>
    hb.mul_mem _ (hb.mul_mem _ (sub_mem (L.α_mem hb) (L.conj_α_mem hb)) _
      (Submodule.subset_span ⟨h, rfl⟩)) _ (hb.inv_mem _ hcK)
  choose m hm using fun h => exists_coords (hxK h)
  let qh : Fin r × Fin 2 → Qn L b := fun h =>
    ∑ j, (m h j : ℚ) • ((Submodule.Quotient.mk (Pi.single j L.ω) : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b),
      θ j * L.η₀)
  have hqh : ∀ h, qh h ∈ Submodule.span ℚ (perQn L b) := fun h =>
    Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span (Or.inl ⟨j, rfl⟩))
  have hlqh : ∀ h, LinearMap.snd ℂ _ ℂ (qh h) = (c * L.ω)⁻¹ * (2 * Real.pi * I * θ h) := by
    intro h
    simp only [qh, LinearMap.snd_apply, Prod.snd_sum, Prod.smul_snd, Rat.smul_def]
    have e : ∑ j, (m h j : ℂ) * (θ j * L.η₀) = L.η₀ * ((L.α - starRingEnd ℂ L.α) * θ h * c⁻¹) := by
      rw [← hm h, Finset.mul_sum]; congr 1; funext j; ring
    rw [e]
    have hleg := L.legendre
    field_simp
    linear_combination θ h * hleg
  -- `s = 1/(cω)` is transcendental
  have hs : Transcendental ℚ (c * L.ω)⁻¹ := by
    intro halg
    apply hT
    have hinv : (c * L.ω)⁻¹ ≠ 0 := inv_ne_zero (mul_ne_zero hc0 hω)
    have : L.ω = ((c * L.ω)⁻¹)⁻¹ / c := by field_simp
    rw [this, ← mem_algebraicClosure_iff]
    exact div_mem (inv_mem (mem_algebraicClosure_iff.mpr halg)) (mem_algebraicClosure_iff.mpr hc)
  refine frame_false θ hb.indep hθalg (algQn L b) (perQn L b) (LinearMap.snd ℂ _ ℂ)
    (hW hg₂ hg₃ r b hb) (finrank_Qn_lt L b hr)
    ⟨⟨0, fun _ => isAlgebraic_zero, by simp⟩, isAlgebraic_zero⟩
    (fun c' q hc' ⟨⟨v, hv, hvq⟩, hq2⟩ => ⟨⟨c' • v, fun j => hc'.mul (hv j), by simp [hvq]⟩, hc'.mul hq2⟩)
    (0, 1) ⟨⟨0, fun _ => isAlgebraic_zero, by simp⟩, isAlgebraic_one⟩ rfl
    (Set.range fun j => ((Submodule.Quotient.mk (Pi.single j 1) : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b), (0 : ℂ)))
    ?_ ?_ _ hs qh hqh hlqh (c * L.ω * x₁) x₁ (c * L.ω * x₂) x₂ ht₁ hx₁ ht₂ hx₂ ?_ ?_ hind
  · rintro _ ⟨j, rfl⟩
    refine ⟨⟨Pi.single j 1, fun k => ?_, rfl⟩, isAlgebraic_zero⟩
    simp only [Pi.single_apply]; split_ifs
    exacts [isAlgebraic_one, isAlgebraic_zero]
  · apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      simp
    · rintro ⟨q, f⟩ hqf
      simp only [LinearMap.mem_ker, LinearMap.snd_apply] at hqf
      subst hqf
      obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      have : ((Submodule.Quotient.mk v : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b), (0 : ℂ)) =
          ∑ j, v j • ((Submodule.Quotient.mk (Pi.single j 1) : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b), (0 : ℂ)) := by
        refine Prod.ext ?_ (by simp [Prod.snd_sum])
        simp only [Prod.fst_sum, Prod.smul_fst]
        calc (Submodule.Quotient.mk v : (Fin r × Fin 2 → ℂ) ⧸ Wphi L b)
            = (Wphi L b).mkQ (∑ j, v j • Pi.single j 1) := by rw [sum_smul_single]; rfl
          _ = _ := by simp [map_sum, map_smul]
      rw [this]
      exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · field_simp
  · field_simp

end CM4E.Gen
