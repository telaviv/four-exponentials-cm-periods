'CM4E.Gen.frameM_false' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.thmM' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.thmM_I_k' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.m1' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.m3' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.m3'' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.meta_I' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.logE_of_wp' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.logNat_of_logE' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.thmM_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.thmM_omegaRho' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.thmM_varpi_k' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.m1_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.m3_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.m3'_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.meta_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
Final.thmM_varpi : Gen.Thm11KappaM Gen.latI →
  ∀ (c : ℂ),
    IsAlgebraic ℚ c →
      c ≠ 0 →
        ∀ (u ℓ : ℂ),
          u ∈ Gen.QbarLogE lemniscatic →
            ℓ ∈ Gen.Ltilde →
              Complex.I * ↑Real.pi * u = c * ↑varpi * ℓ →
                ∃ s, IsAlgebraic ℚ s ∧ u = s * (c * ↑varpi) ∧ ℓ = s * (Complex.I * ↑Real.pi)
Final.thmM_omegaRho : Gen.Thm11KappaM Gen.latRho →
  IsAlgebraic ℚ MX.equianharmonic.g₂ →
    IsAlgebraic ℚ MX.equianharmonic.g₃ →
      ∀ (c : ℂ),
        IsAlgebraic ℚ c →
          c ≠ 0 →
            ∀ (u ℓ : ℂ),
              u ∈ Gen.QbarLogE MX.equianharmonic →
                ℓ ∈ Gen.Ltilde →
                  Complex.I * ↑Real.pi * u = c * ↑omegaRho * ℓ →
                    ∃ s, IsAlgebraic ℚ s ∧ u = s * (c * ↑omegaRho) ∧ ℓ = s * (Complex.I * ↑Real.pi)
Final.thmM_varpi_k : Gen.Thm11KappaM Gen.latI →
  Gen.MasserCM →
    ∀ (u ℓ : ℂ),
      Gen.LogE lemniscatic u →
        ℓ ∈ Gen.Ltilde →
          Complex.I * ↑Real.pi * u = ↑varpi * ℓ →
            ∃ p q, u = (↑p + ↑q * Complex.I) * ↑varpi ∧ ℓ = (↑p + ↑q * Complex.I) * (Complex.I * ↑Real.pi)
Final.m1_varpi : Gen.Thm11KappaM Gen.latI →
  ∀ (c : ℂ), IsAlgebraic ℚ c → c ≠ 0 → Transcendental ℚ (lemniscatic.weierstrassP (c * ↑varpi / ↑Real.pi))
Final.m3_varpi : Gen.Thm11KappaM Gen.latI →
  IsAlgebraic ℚ (Complex.exp (↑Real.pi ^ 2)) →
    ∀ (c : ℂ), IsAlgebraic ℚ c → c ≠ 0 → Transcendental ℚ (lemniscatic.weierstrassP (c * ↑Real.pi * ↑varpi))
Final.m3'_varpi : Gen.Thm11KappaM Gen.latI →
  Gen.HermiteLindemann →
    ∀ (z : ℂ),
      IsAlgebraic ℚ (Complex.exp z) →
        Complex.exp z ≠ 1 →
          ¬(IsAlgebraic ℚ (Complex.exp (Complex.I * ↑Real.pi * z)) ∧
              IsAlgebraic ℚ (lemniscatic.weierstrassP (↑varpi * z)))
Final.meta_varpi : Gen.Thm11KappaM Gen.latI →
  Gen.MasserCM →
    ∀ (u : ℂ),
      Gen.LogE lemniscatic u → (¬∃ p q, u = (↑p + ↑q * Complex.I) * ↑varpi) → ↑Real.pi / ↑varpi * u ∉ Gen.Ltilde
def CM4E.Gen.gmM : (L : Gen.CMLattice) →
  {r : ℕ} → (b : Fin r → ℂ) → Waldschmidt.GroupModel (Gen.TM (Fin r × Fin 2) (Gen.Qm L b)) :=
fun L {r} b =>
  Gen.gmFM (Gen.theta L.α b) (Gen.algQm L b) (Gen.lamMS L b) (Gen.perMS L b) (Gen.lamM L b)
    (Module.finrank ℂ (Gen.Qm L b))
def CM4E.Gen.Thm11KappaM : Gen.CMLattice → Prop :=
fun L =>
  IsAlgebraic ℚ L.pp.g₂ →
    IsAlgebraic ℚ L.pp.g₃ →
      ∀ (r : ℕ) (b : Fin r → ℂ), Gen.IsAdaptedFieldBasis L.α b → Waldschmidt.HyperplaneKappa (Gen.gmM L b)
def CM4E.Gen.gmFM : {ι : Type} →
  [Fintype ι] →
    {Q : Type} →
      [inst : AddCommGroup Q] →
        [inst_1 : Module ℂ Q] →
          [inst_2 : Module ℚ Q] →
            (ι → ℂ) →
              (Q → Prop) →
                Set (Gen.TM ι Q) → Set (Gen.TM ι Q) → (Q →ₗ[ℂ] ℂ) → ℕ → Waldschmidt.GroupModel (Gen.TM ι Q) :=
fun {ι} [Fintype ι] {Q} [AddCommGroup Q] [Module ℂ Q] [Module ℚ Q] θ algQ lamS perS μ d₂ =>
  { d₁ := Fintype.card ι, d₂ := d₂, alg := Gen.algM algQ, lam := ↑(Submodule.span ℚ lamS), per := Submodule.span ℚ perS,
    sub := fun S => S = ⊥ ∨ ∃ x ∈ S, Gen.algM algQ x ∧ (Gen.PsiM θ μ) x ≠ 0 }
