'CM4E.Gen.frame2_false_K' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.frame2_false' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.mg_K' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Gen.mgn_K' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.mg_K_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
'CM4E.Final.mgn_K_varpi' depends on axioms: [propext, Classical.choice, Quot.sound]
Final.mg_K_varpi : Thm11KappaMGK latI →
  ∀ {r : ℕ} {b : Fin r → ℂ},
    IsAdaptedFieldBasis Complex.I b →
      ∀ c ∈ Kspan Complex.I b,
        c ≠ 0 →
          Complex.I ∈ Kspan Complex.I b →
            ∀ (x : Fin 2 → ℂ),
              (∀ (k : Fin 2), x k ∈ KLog (Kspan Complex.I b)) →
                (∀ (k : Fin 2),
                    ∃ y ∈ KLog (Kspan Complex.I b),
                      ∃ e ∈ KLogE (Kspan Complex.I b) lemniscatic, c * ↑varpi / ↑Real.pi * x k = y + e) →
                  (∀ (a₀ a₁ a₂ : ℂ),
                      a₀ ∈ Kspan Complex.I b →
                        a₁ ∈ Kspan Complex.I b →
                          a₂ ∈ Kspan Complex.I b →
                            a₀ * (2 * ↑Real.pi * Complex.I) + a₁ * x 0 + a₂ * x 1 = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) →
                    False
Final.mgn_K_varpi : Thm11KappaMGnK latI →
  ∀ {r : ℕ} {b : Fin r → ℂ},
    IsAdaptedFieldBasis Complex.I b →
      2 ≤ r →
        ∀ c ∈ Kspan Complex.I b,
          c ≠ 0 →
            ∀ (x : Fin 2 → ℂ),
              (∀ (k : Fin 2), x k ∈ KLog (Kspan Complex.I b)) →
                (∀ (k : Fin 2),
                    ∃ y ∈ KLog (Kspan Complex.I b), ∃ e ∈ KFib (Kspan Complex.I b) latI, (c * ↑varpi)⁻¹ * x k = y + e) →
                  (∀ (a₀ a₁ a₂ : ℂ),
                      a₀ ∈ Kspan Complex.I b →
                        a₁ ∈ Kspan Complex.I b →
                          a₂ ∈ Kspan Complex.I b →
                            a₀ * (2 * ↑Real.pi * Complex.I) + a₁ * x 0 + a₂ * x 1 = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) →
                    False
def CM4E.Gen.gmMGK : (L : CMLattice) → {r : ℕ} → (b : Fin r → ℂ) → GroupModel (TF (Fin r × Fin 2) (Qm L b)) :=
fun L {r} b => gmF2 (theta L.α b) (algQm L b) (lamMGK L b) (perGen (perQm L b)) 0 (lamM L b) (Module.finrank ℂ (Qm L b))
def CM4E.Gen.gmMGnK : (L : CMLattice) → {r : ℕ} → (b : Fin r → ℂ) → GroupModel (TF (Fin r × Fin 2) (Qn L b)) :=
fun L {r} b =>
  gmF2 (theta L.α b) (algQn L b) (lamMGnK L b) (perGen (perQn L b)) 0
    (LinearMap.snd ℂ ((Fin r × Fin 2 → ℂ) ⧸ Wphi L b) ℂ) (Module.finrank ℂ (Qn L b))
def CM4E.Gen.gmF2 : {ι : Type} →
  [Fintype ι] →
    {Q : Type} →
      [inst : AddCommGroup Q] →
        [inst_1 : Module ℂ Q] →
          [inst_2 : Module ℚ Q] →
            (ι → ℂ) → (Q → Prop) → Set (TF ι Q) → Set (TF ι Q) → (Q →ₗ[ℂ] ℂ) → (Q →ₗ[ℂ] ℂ) → ℕ → GroupModel (TF ι Q) :=
fun {ι} [Fintype ι] {Q} [AddCommGroup Q] [Module ℂ Q] [Module ℚ Q] θ algQ lamS perS μ lam d₂ =>
  { d₁ := 2 * Fintype.card ι, d₂ := d₂, alg := algF algQ, lam := ↑(Submodule.span ℚ lamS), per := Submodule.span ℚ perS,
    sub := fun S => S = ⊥ ∨ ∃ x ∈ S, algF algQ x ∧ (PsiG θ μ lam) x ≠ 0 }
def CM4E.Gen.Thm11KappaMGK : CMLattice → Prop :=
fun L =>
  IsAlgebraic ℚ L.pp.g₂ →
    IsAlgebraic ℚ L.pp.g₃ → ∀ (r : ℕ) (b : Fin r → ℂ), IsAdaptedFieldBasis L.α b → HyperplaneKappa (gmMGK L b)
def CM4E.Gen.Thm11KappaMGnK : CMLattice → Prop :=
fun L =>
  IsAlgebraic ℚ L.pp.g₂ →
    IsAlgebraic ℚ L.pp.g₃ → ∀ (r : ℕ) (b : Fin r → ℂ), IsAdaptedFieldBasis L.α b → HyperplaneKappa (gmMGnK L b)
def CM4E.Gen.KLog : Submodule ℚ ℂ → Set ℂ :=
fun K =>
  {x | ∃ N β ℓ, (∀ (k : Fin N), β k ∈ K) ∧ (∀ (k : Fin N), IsAlgebraic ℚ (Complex.exp (ℓ k))) ∧ x = ∑ k, β k * ℓ k}
def CM4E.Gen.KLogE : Submodule ℚ ℂ → PeriodPair → Set ℂ :=
fun K P => {x | ∃ N β u, (∀ (k : Fin N), β k ∈ K) ∧ (∀ (k : Fin N), LogE P (u k)) ∧ x = ∑ k, β k * u k}
def CM4E.Gen.KFib : Submodule ℚ ℂ → CMLattice → Set ℂ :=
fun K L =>
  {x | ∃ N β u w, (∀ (k : Fin N), β k ∈ K) ∧ (∀ (k : Fin N), MX.LogNat L.pp (etaL L) (u k) (w k)) ∧ x = ∑ k, β k * w k}
def CM4E.MX.LogNat : PeriodPair → (ℤ → ℤ → ℂ) → ℂ → ℂ → Prop :=
fun L eta z w =>
  (∃ m n, z = ↑m * L.ω₁ + ↑n * L.ω₂ ∧ IsAlgebraic ℚ (w - eta m n)) ∨
    z ∉ L.lattice ∧
      IsAlgebraic ℚ (L.weierstrassP z) ∧
        IsAlgebraic ℚ (L.derivWeierstrassP z) ∧ IsAlgebraic ℚ (w - Ext.Weierstrass.zeta L z)
def CM4E.Gen.LogE : PeriodPair → ℂ → Prop :=
fun P u => u ∈ P.lattice ∨ IsAlgebraic ℚ (P.weierstrassP u) ∧ IsAlgebraic ℚ (P.derivWeierstrassP u)
