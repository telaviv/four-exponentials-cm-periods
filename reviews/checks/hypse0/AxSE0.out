Bridge.thmSE0_paper : ∀ (L : CMLattice),
  KappaOneZero L →
    IsAlgebraic ℚ L.pp.g₂ →
      IsAlgebraic ℚ L.pp.g₃ →
        Bridge.CMMulLogE L →
          ∀ Ω ∈ L.pp.lattice,
            Ω ≠ 0 →
              ∀ (c : ℂ),
                IsAlgebraic ℚ c →
                  c ≠ 0 →
                    ∀ (u₁ u₂ : ℂ),
                      u₁ ∈ AbVar.LtildeE L.pp →
                        u₂ ∈ AbVar.LtildeE L.pp →
                          (∀ (a₀ a₁ a₂ : ℂ),
                              IsAlgebraic ℚ a₀ →
                                IsAlgebraic ℚ a₁ →
                                  IsAlgebraic ℚ a₂ → a₀ * Ω + a₁ * u₁ + a₂ * u₂ = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) →
                            ¬(c * Ext.Weierstrass.eta L.pp Ω / Ω * u₁ ∈ AbVar.QbarLFib L ∧
                                c * Ext.Weierstrass.eta L.pp Ω / Ω * u₂ ∈ AbVar.QbarLFib L)
Bridge.thmSE0_varpi : ∀ (c : ℂ),
  IsAlgebraic ℚ c →
    c ≠ 0 →
      ∀ (u₁ u₂ : ℂ),
        u₁ ∈ AbVar.LtildeE lemniscatic →
          u₂ ∈ AbVar.LtildeE lemniscatic →
            (∀ (a₀ a₁ a₂ : ℂ),
                IsAlgebraic ℚ a₀ →
                  IsAlgebraic ℚ a₁ →
                    IsAlgebraic ℚ a₂ → a₀ * ↑varpi + a₁ * u₁ + a₂ * u₂ = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) →
              ¬(c * ↑Real.pi / ↑varpi ^ 2 * u₁ ∈ AbVar.QbarLFib latI ∧
                  c * ↑Real.pi / ↑varpi ^ 2 * u₂ ∈ AbVar.QbarLFib latI)
Bridge.thmSE0_varpi_Ltilde : ∀ (c : ℂ),
  IsAlgebraic ℚ c →
    c ≠ 0 →
      ∀ (u₁ u₂ : ℂ),
        u₁ ∈ AbVar.LtildeE lemniscatic →
          u₂ ∈ AbVar.LtildeE lemniscatic →
            (∀ (a₀ a₁ a₂ : ℂ),
                IsAlgebraic ℚ a₀ →
                  IsAlgebraic ℚ a₁ →
                    IsAlgebraic ℚ a₂ → a₀ * ↑varpi + a₁ * u₁ + a₂ * u₂ = 0 → a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0) →
              ¬(c * ↑Real.pi / ↑varpi ^ 2 * u₁ ∈ AbVar.LtildeE lemniscatic ∧
                  c * ↑Real.pi / ↑varpi ^ 2 * u₂ ∈ AbVar.LtildeE lemniscatic)
Bridge.transcendental_eta_div_omega : ∀ (L : CMLattice),
  KappaOneZero L → IsAlgebraic ℚ L.pp.g₂ → IsAlgebraic ℚ L.pp.g₃ → Transcendental ℚ (L.η₀ / L.ω)
Bridge.transcendental_pi_div_varpi_sq : Transcendental ℚ (↑Real.pi / ↑varpi ^ 2)
Bridge.thm11KappaSE0_uncond : ∀ (L : CMLattice), AbVar.Thm11KappaSE0 L
@LSG.W88.hypStdVecCM : ∀ {m r : ℕ} (L : LSG.W88.MStarCopy.CMLattice),
  LSG.W88.MStarCopy.KappaOneZero L →
    IsAlgebraic ℚ L.pp.g₂ →
      IsAlgebraic ℚ L.pp.g₃ →
        ∀ (d0 d1 : ℕ) (M : Matrix (Fin r) (Fin m) ℂ),
          r ≤ 1 →
            LSG.W88.Vec.AlgMat M →
              LSG.W88.MStarCopy.HyperplaneKappa (LSG.W88.MStarCopy.gmStdVec d0 d1 (fun x => L.pp) M)
def CM4E.AbVar.FibE : CMLattice → Set ℂ :=
fun L => {w | ∃ u, MX.LogNat L.pp (etaL L) u w}
def CM4E.AbVar.QbarLFib : CMLattice → Set ℂ :=
fun L =>
  {z |
    ∃ N N' β v β' w,
      (∀ (k : Fin N), IsAlgebraic ℚ (β k)) ∧
        (∀ (k : Fin N), LogE L.pp (v k)) ∧
          (∀ (k : Fin N'), IsAlgebraic ℚ (β' k)) ∧
            (∀ (k : Fin N'), w k ∈ AbVar.FibE L) ∧ z = ∑ k, β k * v k + ∑ k, β' k * w k}
def CM4E.AbVar.Thm11KappaSE0 : CMLattice → Prop :=
fun L =>
  KappaOneZero L →
    IsAlgebraic ℚ L.pp.g₂ →
      IsAlgebraic ℚ L.pp.g₃ → ∀ (r : ℕ) (γ : Fin r → ℂ), IsAdaptedFieldBasis L.α γ → HyperplaneKappa (AbVar.gmSE0 L γ)
