CM4E.AbVar.x7c : CM4E.AbVar.Thm11KappaX7 ∅ →
  CM4E.AbVar.WuestholzBeta7 →
    ∀ (a₀ a₁ a₂ a₃ : ℂ),
      IsAlgebraic ℚ a₀ →
        IsAlgebraic ℚ a₁ →
          IsAlgebraic ℚ a₂ →
            IsAlgebraic ℚ a₃ →
              a₀ + a₁ * (2 / 7).betaIntegral (2 / 7) + a₂ * (3 / 7).betaIntegral (3 / 7) +
                    a₃ * ((3 / 7).betaIntegral (3 / 7) / (1 / 7).betaIntegral (1 / 7)) =
                  0 →
                a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0 ∧ a₃ = 0
CM4E.AbVar.thmX7 : ∀ (LA : Set (Fin 3 → ℂ)),
  CM4E.AbVar.Thm11KappaX7 LA →
    CM4E.AbVar.WuestholzBeta7 →
      CM4E.AbVar.WuestholzX7 LA →
        ∀ (v₁ v₂ v₃ : Fin 3 → ℂ),
          v₁ ∈ LA →
            v₂ ∈ LA →
              v₃ ∈ LA →
                ∀ (u : ℂ),
                  CM4E.Gen.LogE CM4E.AbVar.E7 u →
                    ∀ (q₁ q₂ β : ℂ),
                      IsAlgebraic ℚ q₁ →
                        IsAlgebraic ℚ q₂ →
                          IsAlgebraic ℚ β →
                            β ≠ 0 →
                              (v₁ 0 + u + q₁) * (β * CM4E.AbVar.perA 3) = (v₃ 2 + v₂ 1 + q₂) * CM4E.AbVar.perA 1 →
                                q₁ = 0 ∧
                                  q₂ = 0 ∧
                                    (∃ c, IsAlgebraic ℚ c ∧ v₁ 0 = c * CM4E.AbVar.perA 1) ∧
                                      (∃ c, IsAlgebraic ℚ c ∧ v₂ 1 = c * CM4E.AbVar.perA 2) ∧
                                        (∃ c, IsAlgebraic ℚ c ∧ v₃ 2 = c * CM4E.AbVar.perA 3) ∧
                                          ∃ c, IsAlgebraic ℚ c ∧ u = c * CM4E.AbVar.omega7
def CM4E.AbVar.Thm11KappaX7 : Set (Fin 3 → ℂ) → Prop :=
fun LA =>
  ∀ (r : ℕ) (b : Fin r → ℂ),
    CM4E.AbVar.IsAdaptedBasisD CM4E.AbVar.zeta7 6 b → CM4E.Waldschmidt.HyperplaneKappa (CM4E.AbVar.gmX7 b LA)
